      m_Items: []
  - m_Id: 6765196323061785
    m_Localized: "\u041B\u0435\u0442\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u043E \u043A \u0434\u0430\u043B\u044C\u043D\u0435\u043C\u0443 \u043A\u0443\u0431\u0443 \u0432 15 \u043C \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C \u0432\u043D\u0443\u0442\u0440\u0438 \u043D\u0435\u0433\u043E. \u0417\u0430\u0442\u0435\u043C \u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C, \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C \u0432 \u0431\u043B\u0438\u0436\u043D\u0435\u043C \u043A\u0443\u0431\u0435 \u0438 \u0441\u044F\u0434\u044C\u0442\u0435. \u041D\u0430\u0447\u0438\u043D\u0430\u0439\u0442\u0435 \u0442\u043E\u0440\u043C\u043E\u0437\u0438\u0442\u044C \u0434\u043E \u0442\u043E\u0433\u043E, \u043A\u0430\u043A \u0434\u043E\u043B\u0435\u0442\u0438\u0442\u0435 \u0434\u043E \u043A\u0443\u0431\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061786
    m_Localized: "\u041F\u043E\u043B\u0451\u0442 \u043F\u043E \u043F\u0440\u044F\u043C\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061787
    m_Localized: "\u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435 \u043F\u0440\u0430\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0441\u0442\u0440\u043E\u0433\u043E \u0432\u0432\u0435\u0440\u0445 \u0438 \u0432\u043D\u0438\u0437, \u043D\u0435 \u043F\u043E \u0434\u0438\u0430\u0433\u043E\u043D\u0430\u043B\u0438."
    m_Metadata:
