  - m_Id: 2872970309652
    m_Localized: "\u041F\u0440\u0438\u0437\u0440\u0430\u0447\u043D\u044B\u0435 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309653
    m_Localized: "\u0422\u0440\u0435\u043D\u0435\u0440 \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0435\u0442 \u0433\u043E\u043D\u043E\u0447\u043D\u0443\u044E \u043B\u0438\u043D\u0438\u044E (\u0437\u0435\u043B\u0451\u043D\u044B\u0439: \u0431\u044B\u0441\u0442\u0440\u043E, \u0436\u0451\u043B\u0442\u044B\u0439: \u0442\u043E\u0440\u043C\u043E\u0437, \u043A\u0440\u0430\u0441\u043D\u044B\u0439: \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E) \u0438 \u0441\u0442\u0440\u0435\u043B\u043A\u0443 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C \u0432\u043E\u0440\u043E\u0442\u0430\u043C. \u041F\u0440\u0438\u0437\u0440\u0430\u0447\u043D\u044B\u0435 \u043A\u043E\u0440\u0438\u0434\u043E\u0440\u044B: \u043C\u043E\u0436\u043D\u043E \u043F\u0440\u043E\u043B\u0435\u0442\u0430\u0442\u044C \u0441\u043A\u0432\u043E\u0437\u044C \u0441\u0442\u043E\u043B\u0431\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309654
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043A\u0440\u0443\u0448\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309655
