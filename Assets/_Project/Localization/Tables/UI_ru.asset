  - m_Id: 6761043458785290
    m_Localized: "\u0412\u0437\u043B\u0451\u0442, \u0432\u0438\u0441\u0435\u043D\u0438\u0435, \u043F\u043E\u0441\u0430\u0434\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6761043458785291
    m_Localized: "\u0412\u0437\u043B\u0435\u0442\u0438\u0442\u0435 \u0438 \u043F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435\u0441\u044C \u0432 \u0441\u0438\u043D\u0438\u0439 \u043A\u0443\u0431 \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 2 \u043C. \u041E\u0441\u0442\u0430\u0432\u0430\u0439\u0442\u0435\u0441\u044C \u0432 \u043D\u0451\u043C 20 \u0441\u0435\u043A\u0443\u043D\u0434. \u0417\u0430\u0442\u0435\u043C \u0441\u043D\u0438\u0437\u044C\u0442\u0435\u0441\u044C \u0438 \u0441\u044F\u0434\u044C\u0442\u0435 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443, \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u0432\u0437\u043B\u0435\u0442\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6761043458785292
    m_Localized: "\u0412\u0440\u0435\u043C\u044F \u0432\u043D\u0443\u0442\u0440\u0438 \u043A\u0443\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6761043458785293
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0430\u0439\u0442\u0435\u0441\u044C, \u043F\u043E\u043A\u0430 \u0434\u0440\u043E\u043D \u043D\u0435 \u043E\u043A\u0430\u0436\u0435\u0442\u0441\u044F \u0432 \u0441\u0438\u043D\u0435\u043C \u043A\u0443\u0431\u0435, \u0437\u0430\u0442\u0435\u043C \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043F\u0440\u0430\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0438 \u043F\u043E\u043F\u0440\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u043D\u043E\u0441."
    m_Metadata:
      m_Items: []
  - m_Id: 6761043458785294
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0432\u044B\u0441\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6761043458785295
    m_Localized: "\u0421\u043B\u0435\u0434\u0438\u0442\u0435 \u0437\u0430 \u0432\u044B\u0441\u043E\u0442\u043E\u0439 \u0432\u043E \u0432\u0440\u0435\u043C\u044F \u0432\u0438\u0441\u0435\u043D\u0438\u044F: \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435, \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u043B\u0435\u0432\u043E\u0433\u043E \u0441\u0442\u0438\u043A\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6761043458785296
    m_Localized: "\u041F\u043E\u0441\u0430\u0434\u043A\u0430 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6761043458785297
