  - m_Id: 2872957726748
    m_Localized: "(\u043D\u0430\u0436\u043C\u0438\u0442\u0435: \u0440\u0430\u0437\u043C\u0435\u0440)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726749
    m_Localized: "\u041D\u0415\u0422 \u0414\u041E\u041F\u041E\u041B\u041D\u0415\u041D\u0418\u0419"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726750
    m_Localized: "\u041D\u0430\u0436\u043C\u0438\u0442\u0435 \u043D\u0430 \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0443, \u0447\u0442\u043E\u0431\u044B \u0434\u043E\u0431\u0430\u0432\u0438\u0442\u044C \u0438\u043B\u0438 \u0443\u0431\u0440\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726751
    m_Localized: "\u0420\u0410\u0417\u041C\u0415\u0420: {0} mm   ({1})"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726752
    m_Localized: "\u0412\u0415\u0421: {0} g   \u0412\u0418\u041D\u0422\u042B \u0414\u041E {1}\""
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726753
    m_Localized: "\u0421\u0422\u0410\u0422\u041E\u0420: {0}   {1} KV"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726754
    m_Localized: "\u0412\u0415\u0421: {0} g   Rm {1} m\u03A9"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726755
    m_Localized: "\u0420\u0410\u0417\u041C\u0415\u0420: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726756
    m_Localized: "\u0412\u0415\u0421: {0} g"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726757
    m_Localized: "\u0412\u0415\u0421: +{0} g"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726758
    m_Localized: "\xAB{0}\xBB \u0441\u043E\u0445\u0440\u0430\u043D\u0451\u043D \u0438 \u0432\u044B\u0431\u0440\u0430\u043D \u0434\u043B\u044F \u043F\u043E\u043B\u0451\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726759
    m_Localized: "\u0421\u041E\u0425\u0420\u0410\u041D\u0401\u041D: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726760
    m_Localized: "\u0414\u043E\u043F\u043E\u043B\u043D\u0435\u043D\u0438\u044F: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726761
    m_Localized: "\u041C\u0430\u0441\u0441\u0430 {0} g     \u0418\u043D\u0435\u0440\u0446\u0438\u044F (\u0442\u0430\u043D\u0433\u0430\u0436/\u0440\u044B\u0441\u043A\u0430\u043D\u0438\u0435/\u043A\u0440\u0435\u043D) {1} / {2} / {3} (x10^-6 kg m\xB2)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726762
    m_Localized: "\u041B\u0443\u0447\u0438 {0} \xD7 {1} mm     \u0421\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435 (\u0431\u043E\u043A/\u0432\u0435\u0440\u0445/\u043F\u0435\u0440\u0435\u0434) {2} / {3} / {4} kg/m"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726763
    m_Localized: "\u041F\u043E\u043B\u043D\u044B\u0439 \u0433\u0430\u0437: {0} A \u043D\u0430 \u043C\u043E\u0442\u043E\u0440 \u043F\u0440\u0438 {1} V,  {2} \u043E\u0431/\u043C\u0438\u043D,  {3} g \u043D\u0430 \u043C\u043E\u0442\u043E\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726764
    m_Localized: "\u0421\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u043F\u043E \u0448\u0430\u0433\u0443 \u0432\u0438\u043D\u0442\u0430 {0} m/s     \u0420\u0430\u0441\u043A\u0440\u0443\u0442\u043A\u0430 \u043C\u043E\u0442\u043E\u0440\u0430 {1} ms     \u041C\u043E\u043C\u0435\u043D\u0442 \u0440\u044B\u0441\u043A\u0430\u043D\u0438\u044F/\u0442\u044F\u0433\u0430 {2} m"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726765
    m_Localized: "\u041C\u0430\u043A\u0441. \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C {0} km/h     T/W {1}:1     \u0412\u0438\u0441\u0435\u043D\u0438\u0435 {2} %, {3} \u043C\u0438\u043D     \u041F\u0438\u043A. \u0442\u0435\u043C\u043F. \u043C\u043E\u0442\u043E\u0440\u0430 ~{4} \xB0C (\u043E\u0446\u0435\u043D\u043A\u0430)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726766
    m_Localized: "PID \u0442\u0430\u043D\u0433\u0430\u0436 P {0} I {1} D {2}    \u0440\u044B\u0441\u043A\u0430\u043D\u0438\u0435 P {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726767
    m_Localized: "\u0413\u0410\u0417   \u0422\u042F\u0413\u0410 (\u0432\u0441\u0435\u0433\u043E)   \u0422\u041E\u041A/\u043C\u043E\u0442\u043E\u0440   \u041E\u0411/\u041C\u0418\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726768
    m_Localized: "\u0425\u0430\u0440\u0430\u043A\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043A\u0438 \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u044E\u0442\u0441\u044F \u043F\u043E \u0434\u0435\u0442\u0430\u043B\u044F\u043C: \u0440\u0430\u0431\u043E\u0447\u0430\u044F \u0442\u043E\u0447\u043A\u0430 \u043C\u043E\u0442\u043E\u0440\u0430 \u0438 \u0432\u0438\u043D\u0442\u0430 \u043D\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0435 \u043F\u043E\u0434 \u043D\u0430\u0433\u0440\u0443\u0437\u043A\u043E\u0439, \u043F\u043B\u043E\u0449\u0430\u0434\u0438 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044F \u0438 \u043C\u0430\u0441\u0441\u044B \u0434\u0435\u0442\u0430\u043B\u0435\u0439. \u0412 \u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0435 \u043B\u0435\u0442\u0430\u044E\u0442 \u0442\u0435 \u0436\u0435 \u0447\u0438\u0441\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726769
    m_Localized: "\u0417\u0410\u041A\u0420\u042B\u0422\u042C"
