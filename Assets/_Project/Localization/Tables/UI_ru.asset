  - m_Id: 6771039164694567
    m_Localized: "\u041A\u0440\u0443\u0433 \u043F\u043E\u0441\u0430\u0434\u043E\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039168888832
    m_Localized: "\u0427\u0435\u0442\u044B\u0440\u0435 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0438, \u043A\u0430\u0436\u0434\u0430\u044F \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0439. \u0421\u044F\u0434\u044C\u0442\u0435 \u043D\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u043F\u043E \u043E\u0447\u0435\u0440\u0435\u0434\u0438 \u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043C\u043E\u0442\u043E\u0440\u044B, \u0437\u0430\u0442\u0435\u043C \u0432\u0437\u043B\u0435\u0442\u0430\u0439\u0442\u0435 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0439. \u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0435, \u0441 \u043A\u043E\u0442\u043E\u0440\u043E\u0439 \u043D\u0430\u0447\u0430\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039168888833
    m_Localized: "\u0412\u0437\u043B\u0435\u0442\u0438\u0442\u0435 \u0438 \u0437\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u043D\u0430\u0434 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u043E\u0439 \u043D\u0430 10 \u0441\u0435\u043A\u0443\u043D\u0434; \u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C \u043F\u0440\u043E\u0442\u0438\u0432 \u0432\u0435\u0442\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039168888834
    m_Localized: "\u0411\u0435\u0437 \u0443\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u044F \u043F\u043E\u0437\u0438\u0446\u0438\u0438, \u043D\u0430 \u0432\u0435\u0442\u0440\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039168888835
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u043F\u043E\u0437\u0438\u0446\u0438\u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u043E: \u0434\u0440\u043E\u043D \u0434\u0435\u0440\u0436\u0438\u0442 \u0432\u044B\u0441\u043E\u0442\u0443, \u043D\u043E \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u0442\u0430\u043C, \u0433\u0434\u0435 \u0432\u044B \u0435\u0433\u043E \u043E\u0441\u0442\u0430\u0432\u0438\u043B\u0438, \u0438 \u043B\u0451\u0433\u043A\u0438\u0439 \u0432\u0435\u0442\u0435\u0440 \u0441\u043D\u043E\u0441\u0438\u0442 \u0435\u0433\u043E \u0432\u0431\u043E\u043A. \u0417\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435, \u0437\u0430\u0442\u0435\u043C \u043F\u0440\u043E\u043B\u0435\u0442\u0438\u0442\u0435 \u043A\u0432\u0430\u0434\u0440\u0430\u0442. \u0422\u0430\u043A \u043B\u0435\u0442\u0438\u0442 \u0434\u0440\u043E\u043D, \u043F\u043E\u0442\u0435\u0440\u044F\u0432\u0448\u0438\u0439 \u0441\u043F\u0443\u0442\u043D\u0438\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6775319762305024
    m_Localized: "\u041E\u0431\u043B\u0435\u0442\u0438\u0442\u0435 \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u043E\u043B\u0431 \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0435"
