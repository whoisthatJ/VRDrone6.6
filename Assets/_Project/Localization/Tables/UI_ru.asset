  - m_Id: 2872970309717
    m_Localized: "\u041D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0440\u0430\u0437 \u043E\u0442\u0432\u0435\u0434\u0438\u0442\u0435 \u041E\u0411\u0410 \u0441\u0442\u0438\u043A\u0430 \u0432\u043E \u0432\u0441\u0435 \u0443\u0433\u043B\u044B. (\u043D\u0430\u0439\u0434\u0435\u043D\u043E \u043E\u0441\u0435\u0439: {0}/4)\n\u041D\u0435 \u0442\u0440\u043E\u0433\u0430\u0439\u0442\u0435 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309718
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u043E\u0431\u0430 \u0441\u0442\u0438\u043A\u0430 \u0432 \u0446\u0435\u043D\u0442\u0440, \u0413\u0410\u0417 \u0412\u041D\u0418\u0417, \u0438 \u043D\u0435 \u0434\u0432\u0438\u0433\u0430\u0439\u0442\u0435..."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309719
    m_Localized: "\u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435 \u0413\u0410\u0417 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0412\u0412\u0415\u0420\u0425 \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309720
    m_Localized: "\u0413\u0430\u0437 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432\u043D\u0438\u0437. \u041E\u0442\u0432\u0435\u0434\u0438\u0442\u0435 \u0420\u042B\u0421\u041A\u0410\u041D\u0418\u0415 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0412\u041F\u0420\u0410\u0412\u041E \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309721
    m_Localized: "\u0420\u044B\u0441\u043A\u0430\u043D\u0438\u0435 \u0432 \u0446\u0435\u043D\u0442\u0440. \u041E\u0442\u0432\u0435\u0434\u0438\u0442\u0435 \u0422\u0410\u041D\u0413\u0410\u0416 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0412\u041F\u0415\u0420\u0401\u0414 (\u043D\u043E\u0441 \u0432\u043D\u0438\u0437) \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309722
    m_Localized: "\u0422\u0430\u043D\u0433\u0430\u0436 \u0432 \u0446\u0435\u043D\u0442\u0440. \u041E\u0442\u0432\u0435\u0434\u0438\u0442\u0435 \u041A\u0420\u0415\u041D \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E \u0412\u041F\u0420\u0410\u0412\u041E \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309723
    m_Localized: "\u0421\u0442\u0438\u043A\u0438 \u0432 \u0446\u0435\u043D\u0442\u0440. \u041F\u0435\u0440\u0435\u0432\u0435\u0434\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C ARM \u0432 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 ARMED \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435.\n(\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0435\u0441\u043B\u0438 \u0445\u043E\u0442\u0438\u0442\u0435 \u0432\u0437\u0432\u043E\u0434\u0438\u0442\u044C \u043C\u043E\u0442\u043E\u0440\u044B \u0433\u0430\u0437\u043E\u043C \u0432 \u043D\u0438\u0436\u043D\u0435\u043C \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0438.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309724
    m_Localized: "\u041F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C MODE \u0432 ACRO, \u0437\u0430\u0442\u0435\u043C \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0438\u0442\u0435 \u0432 ANGLE \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435.\n(\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0435\u0441\u043B\u0438 \u043D\u0435 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442\u0435 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C \u0440\u0435\u0436\u0438\u043C\u043E\u0432.)"
