  - m_Id: 6753576817524739
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u043F\u043E\u0437\u0438\u0446\u0438\u0438: \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u0435 \u0441\u0442\u0438\u043A\u0438, \u0438 \u0434\u0440\u043E\u043D \u043E\u0441\u0442\u0430\u043D\u0435\u0442\u0441\u044F \u043D\u0430 \u043C\u0435\u0441\u0442\u0435. \u0412 \u043F\u043E\u043B\u0451\u0442\u0435 G \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0435\u0442 \u043F\u043E\u043C\u043E\u0449\u044C, L \u043F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442 \u0437\u0430\u043F\u0438\u0441\u044C \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0433\u043E \u043F\u043E\u043B\u0451\u0442\u0430."
