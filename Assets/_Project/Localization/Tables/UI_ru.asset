    m_Localized: "65-\u043C\u043C \u0432\u0443\u043F \u0441 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u0432\u0438\u043D\u0442\u043E\u0432. \u041E\u0442\u0441\u043A\u0430\u043A\u0438\u0432\u0430\u0435\u0442 \u043E\u0442 \u0441\u0442\u0435\u043D, \u043B\u0435\u0442\u0430\u0435\u0442 \u0432 \u043F\u043E\u043C\u0435\u0449\u0435\u043D\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921034
    m_Localized: "2.5\" \u0441\u0438\u043D\u0435\u0432\u0443\u043F \u0432 \u043A\u043E\u043B\u044C\u0446\u0430\u0445: \u043C\u044F\u0433\u043A\u0438\u0439, \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439, \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921035
    m_Localized: "\u0421\u0432\u0435\u0440\u0445\u043B\u0451\u0433\u043A\u0438\u0439 3\" toothpick. \u041B\u0451\u0433\u043A\u0438\u0439, \u0432\u0451\u0440\u0442\u043A\u0438\u0439, \u0445\u0440\u0443\u043F\u043A\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921036
    m_Localized: "3.5\" \u043A\u0438\u043D\u043E-\u0434\u0440\u043E\u043D \u0432 \u043A\u043E\u043B\u044C\u0446\u0430\u0445 \u043D\u0430 6S: \u043F\u043E\u0434\u043D\u0438\u043C\u0430\u0435\u0442 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0443\u044E HD-\u043A\u0430\u043C\u0435\u0440\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921037
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u0435\u043D\u043D\u044B\u0439 \u0432 \u0433\u043E\u043D\u043A\u0430\u0445 true-X. \u041D\u0438\u0437\u043A\u043E\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435, \u0442\u043E\u043D\u043A\u0438\u0435 \u043B\u0443\u0447\u0438, \u043B\u0451\u0433\u043A\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921038
    m_Localized: "\u0421\u0432\u0435\u0440\u0445\u043B\u0451\u0433\u043A\u0430\u044F \u0433\u043E\u043D\u043E\u0447\u043D\u0430\u044F \u0440\u0430\u043C\u0430. \u0422\u043E\u043D\u043A\u0438\u0435 \u043B\u0443\u0447\u0438: \u0431\u044B\u0441\u0442\u0440\u0430\u044F, \u043D\u043E \u0433\u043D\u0451\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921039
    m_Localized: "\u041F\u0440\u043E\u0447\u043D\u044B\u0439 stretched-X \u0434\u043B\u044F \u0444\u0440\u0438\u0441\u0442\u0430\u0439\u043B\u0430. \u0422\u043E\u043B\u0441\u0442\u044B\u0435 \u043B\u0443\u0447\u0438 6 mm."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921040
    m_Localized: "\u0413\u0435\u043E\u043C\u0435\u0442\u0440\u0438\u044F Deadcat: \u0432\u0438\u043D\u0442\u044B \u043D\u0435 \u043F\u043E\u043F\u0430\u0434\u0430\u044E\u0442 \u0432 \u043A\u0430\u0434\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921041
    m_Localized: "7\" \u0434\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u044B\u0439 \u043A\u0440\u0443\u0437\u0435\u0440. \u042D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u044B\u0439, \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439, \u043B\u0435\u0442\u0438\u0442 \u0434\u0430\u043B\u0435\u043A\u043E."
    m_Metadata:
      m_Items: []
