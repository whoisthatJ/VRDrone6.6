    m_Metadata:
      m_Items: []
  - m_Id: 2872970309665
    m_Localized: "\u0411\u043E\u043B\u044C\u0448\u0430\u044F \u043E\u0442\u043A\u0440\u044B\u0442\u0430\u044F \u043F\u0435\u0442\u043B\u044F \u0441 \u043F\u0430\u0440\u044F\u0449\u0438\u043C\u0438 \u0432\u043E\u0440\u043E\u0442\u0430\u043C\u0438 \u0438 \u0431\u0430\u0440\u044C\u0435\u0440\u043E\u043C. \u0415\u0441\u0442\u044C \u0433\u0434\u0435 \u0443\u0447\u0438\u0442\u044C\u0441\u044F."
