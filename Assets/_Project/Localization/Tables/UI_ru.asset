    m_Localized: "\u0422\u0440\u0451\u0445\u043B\u043E\u043F\u0430\u0441\u0442\u043D\u043E\u0439 \u0432\u0438\u043D\u0442 \u0434\u043B\u044F \u043A\u043E\u043B\u0435\u0446."
