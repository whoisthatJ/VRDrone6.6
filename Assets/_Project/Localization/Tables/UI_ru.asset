  - m_Id: 6778737700634627
    m_Localized: "\u0417\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u043D\u0430\u0434 \u0432\u0435\u0434\u0440\u043E\u043C \u043D\u0430 \u0437\u0435\u043C\u043B\u0435, \u043D\u0430\u043A\u043B\u043E\u043D\u0438\u0442\u0435 \u043A\u0430\u043C\u0435\u0440\u0443 \u0441\u0442\u0440\u043E\u0433\u043E \u0432\u043D\u0438\u0437 \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634628
    m_Localized: "\u041F\u043E\u0437\u0438\u0446\u0438\u044F: \u0442\u0440\u0438 \u0432\u0435\u0434\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634629
    m_Localized: "\u0422\u0440\u0438 \u0432\u0435\u0434\u0440\u0430: \u043E\u0434\u043D\u043E \u043D\u0438\u0437\u043A\u043E, \u043E\u0434\u043D\u043E \u0432\u044B\u0441\u043E\u043A\u043E, \u043E\u0434\u043D\u043E \u043B\u0435\u0436\u0438\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u043E\u0439 \u0432\u0432\u0435\u0440\u0445. \u041F\u043E\u0441\u0442\u0430\u0432\u044C\u0442\u0435 \u0434\u0440\u043E\u043D \u0442\u0430\u043A, \u0447\u0442\u043E\u0431\u044B \u043A\u0430\u043C\u0435\u0440\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u043B\u0430 \u043F\u0440\u044F\u043C\u043E \u0432 \u043A\u0430\u0436\u0434\u043E\u0435, \u0438 \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0441\u043D\u0438\u043C\u043E\u043A. Page Up \u0438 Page Down \u043D\u0430\u043A\u043B\u043E\u043D\u044F\u044E\u0442 \u043A\u0430\u043C\u0435\u0440\u0443, Z \u0438 X \u043C\u0435\u043D\u044F\u044E\u0442 \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0435\u043D\u0438\u0435, P \u0434\u0435\u043B\u0430\u0435\u0442 \u0441\u043D\u0438\u043C\u043E\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634630
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u043D\u043E \u0441\u043D\u0438\u043C\u043A\u043E\u0432"
