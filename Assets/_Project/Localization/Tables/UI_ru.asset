    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061760
    m_Localized: "\u041F\u0440\u043E\u0432\u0435\u0440\u043A\u0430 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061761
    m_Localized: "\u0414\u0440\u043E\u043D \u0441\u0442\u043E\u0438\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u0441 \u0432\u044B\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u043C\u0438 \u043C\u043E\u0442\u043E\u0440\u0430\u043C\u0438. \u0414\u0432\u0438\u0433\u0430\u0439\u0442\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0442\u0438\u043A \u0442\u0430\u043A, \u043A\u0430\u043A \u043F\u0440\u043E\u0441\u0438\u0442 \u044D\u043A\u0440\u0430\u043D: \u0434\u043E \u0443\u043F\u043E\u0440\u0430 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u0432 \u0446\u0435\u043D\u0442\u0440. \u0422\u0430\u043A \u0432\u044B \u0437\u0430\u043F\u043E\u043C\u043D\u0438\u0442\u0435, \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u0442\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061762
    m_Localized: "\u0412\u044B\u043F\u043E\u043B\u043D\u0435\u043D\u043D\u044B\u0435 \u0448\u0430\u0433\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061763
    m_Localized: "\u0412\u044B\u043F\u043E\u043B\u043D\u044F\u0439\u0442\u0435 \u0448\u0430\u0433\u0438 \u0432 \u0442\u043E\u043C \u043F\u043E\u0440\u044F\u0434\u043A\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u043F\u043E\u043A\u0430\u0437\u0430\u043D \u0432\u0432\u0435\u0440\u0445\u0443 \u044D\u043A\u0440\u0430\u043D\u0430; \u043A\u0430\u0436\u0434\u044B\u0439 \u0437\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0435\u0433\u043E."
    m_Metadata:
      m_Items: []
