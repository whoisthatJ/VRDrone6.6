      m_Items: []
  - m_Id: 2872970309725
    m_Localized: "\u0415\u0441\u043B\u0438 \u0443 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044F \u0440\u0435\u0436\u0438\u043C\u043E\u0432 \u0435\u0441\u0442\u044C \u0442\u0440\u0435\u0442\u044C\u0435 \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435, \u043F\u0435\u0440\u0435\u0432\u0435\u0434\u0438\u0442\u0435 \u0435\u0433\u043E \u0432 HORIZON \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435.\n(\u0427\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u043A\u0443\u043D\u0434 \u0448\u0430\u0433 \u043F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0441\u044F \u0441\u0430\u043C.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309726
    m_Localized: "\u041D\u0435\u043E\u0431\u044F\u0437\u0430\u0442\u0435\u043B\u044C\u043D\u043E: \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u0442\u0443\u043C\u0431\u043B\u0435\u0440 (\u0438\u043B\u0438 \u043D\u0430\u0436\u043C\u0438\u0442\u0435 \u043A\u043D\u043E\u043F\u043A\u0443) \u0434\u043B\u044F \u0412\u0418\u0414\u0410 \u041A\u0410\u041C\u0415\u0420\u042B \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435.\n(\u041F\u0440\u043E\u043F\u0443\u0441\u0442\u0438\u0442\u0435, \u0435\u0441\u043B\u0438 \u043D\u0435 \u043D\u0443\u0436\u043D\u043E.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309727
    m_Localized: "\u0413\u043E\u0442\u043E\u0432\u043E! \u0412\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u043A\u043B\u044E\u0447\u0430\u0442\u0435\u043B\u044C ARM."
