    m_Localized: "\u042F\u0440\u043A\u0438\u0435 LED-\u043B\u0435\u043D\u0442\u044B \u0432\u0434\u043E\u043B\u044C \u0440\u0430\u043C\u044B. \u0421\u0442\u0438\u043B\u044C \u043D\u043E\u0447\u043D\u044B\u0445 \u0433\u043E\u043D\u043E\u043A."
    m_Metadata:
      m_Items: []
