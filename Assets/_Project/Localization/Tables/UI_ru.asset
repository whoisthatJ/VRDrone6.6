  - m_Id: 6753576817524745
    m_Localized: "\u0423\u0447\u0435\u0431\u043D\u044B\u0439 \u0434\u0440\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524746
    m_Localized: "\u0421\u043A\u043B\u0430\u0434\u043D\u043E\u0439 \u0434\u0440\u043E\u043D \u0441\u043E \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0439 \u043A\u0430\u043C\u0435\u0440\u043E\u0439. \u0421\u0430\u043C \u0434\u0435\u0440\u0436\u0438\u0442 \u043C\u0435\u0441\u0442\u043E, \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432 \u043D\u0430 \u0432\u0435\u0442\u0440\u0443, \u043F\u043E\u043B\u0447\u0430\u0441\u0430 \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524747
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0434\u0440\u043E\u043D \u0441 \u043A\u0430\u043C\u0435\u0440\u043E\u0439, \u043B\u0435\u0433\u0447\u0435 250 \u0433. \u041B\u0451\u0433\u043A\u0438\u0439 \u0438 \u0442\u0438\u0445\u0438\u0439; \u0432\u0435\u0442\u0435\u0440 \u0441\u043D\u043E\u0441\u0438\u0442 \u0435\u0433\u043E \u0440\u0430\u043D\u044C\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524748
    m_Localized: "2,5 \u043A\u0433, \u0440\u0430\u0441\u0441\u0447\u0438\u0442\u0430\u043D \u043D\u0435\u0441\u0442\u0438 \u043A\u043E\u0440\u043E\u0431\u043A\u0443 \u0432\u0435\u0441\u043E\u043C 1 \u043A\u0433 \u0438 \u043E\u043F\u0443\u0441\u043A\u0430\u0442\u044C \u0435\u0451 \u0442\u0430\u043C, \u0433\u0434\u0435 \u043D\u0443\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524749
    m_Localized: "\u041C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0439 \u0434\u0440\u043E\u043D \u0441 \u0437\u0430\u0449\u0438\u0442\u043E\u0439 \u0432\u0438\u043D\u0442\u043E\u0432, \u0434\u0432\u0443\u043C\u044F \u043A\u0430\u043C\u0435\u0440\u0430\u043C\u0438 \u0438 \u0434\u0430\u0442\u0447\u0438\u043A\u0430\u043C\u0438 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F: \u0438\u043C\u0435\u043D\u043D\u043E \u0435\u0433\u043E \u043F\u0440\u043E\u0433\u0440\u0430\u043C\u043C\u0438\u0440\u0443\u044E\u0442."
