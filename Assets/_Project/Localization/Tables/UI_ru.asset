  - m_Id: 6765196323061791
    m_Localized: "\u041B\u0435\u0442\u0438\u0442\u0435 \u043A \u0443\u0433\u043B\u0443 4 \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C \u043D\u0430 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061792
    m_Localized: "\u0417\u0430\u043C\u043A\u043D\u0438\u0442\u0435 \u043A\u0432\u0430\u0434\u0440\u0430\u0442: \u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u043A \u0443\u0433\u043B\u0443 1 \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C \u043D\u0430 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061793
    m_Localized: "\u041A\u0432\u0430\u0434\u0440\u0430\u0442 \u0445\u0432\u043E\u0441\u0442\u043E\u043C \u043A \u0441\u0435\u0431\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061794
    m_Localized: "\u041F\u0440\u043E\u043B\u0435\u0442\u0438\u0442\u0435 \u043A\u0432\u0430\u0434\u0440\u0430\u0442 \u0447\u0435\u0440\u0435\u0437 \u0447\u0435\u0442\u044B\u0440\u0435 \u043A\u0443\u0431\u0430, \u043E\u0441\u0442\u0430\u043D\u0430\u0432\u043B\u0438\u0432\u0430\u044F\u0441\u044C \u0432 \u043A\u0430\u0436\u0434\u043E\u043C. \u0412\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u0434\u0440\u043E\u043D \u0445\u0432\u043E\u0441\u0442\u043E\u043C \u043A \u0441\u0435\u0431\u0435, \u0442\u043E\u0433\u0434\u0430 \u043B\u0435\u0432\u043E \u0432\u0441\u0435\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442 \u0441\u043B\u0435\u0432\u0430. \u0417\u0430\u0442\u0435\u043C \u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0438 \u0441\u044F\u0434\u044C\u0442\u0435 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061795
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0445\u0432\u043E\u0441\u0442\u043E\u043C \u043A \u0441\u0435\u0431\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061796
    m_Localized: "\u041D\u0435 \u043E\u0442\u043A\u043B\u043E\u043D\u044F\u0439\u0442\u0435 \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A \u0432\u043F\u0440\u0430\u0432\u043E-\u0432\u043B\u0435\u0432\u043E: \u0432 \u044D\u0442\u043E\u043C \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u0438 \u0434\u0440\u043E\u043D \u043D\u0435 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442\u0441\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039097585664
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C, \u0441\u044F\u0434\u044C\u0442\u0435 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443 \u0438 \u0432\u044B\u043A\u043B\u044E\u0447\u0438\u0442\u0435 \u043C\u043E\u0442\u043E\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694528
    m_Localized: "\u041B\u0435\u0442\u0438\u0442\u0435 \u043A \u0443\u0433\u043B\u0443 1 \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694529
    m_Localized: "\u041F\u043E\u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u043D\u043E\u0441 \u043A \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u043C\u0443 \u0443\u0433\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694530
    m_Localized: "\u041B\u0435\u0442\u0438\u0442\u0435 \u043A \u0443\u0433\u043B\u0443 2 \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694531
    m_Localized: "\u041B\u0435\u0442\u0438\u0442\u0435 \u043A \u0443\u0433\u043B\u0443 3 \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694532
    m_Localized: "\u041B\u0435\u0442\u0438\u0442\u0435 \u043A \u0443\u0433\u043B\u0443 4 \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694533
    m_Localized: "\u0417\u0430\u043C\u043A\u043D\u0438\u0442\u0435 \u043A\u0432\u0430\u0434\u0440\u0430\u0442: \u0432\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u043A \u0443\u0433\u043B\u0443 1"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694534
    m_Localized: "\u041A\u0432\u0430\u0434\u0440\u0430\u0442 \u043D\u043E\u0441\u043E\u043C \u0432\u043F\u0435\u0440\u0451\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694535
    m_Localized: "\u041F\u0440\u043E\u043B\u0435\u0442\u0438\u0442\u0435 \u043A\u0432\u0430\u0434\u0440\u0430\u0442 \u0441\u043D\u043E\u0432\u0430, \u043D\u043E \u0442\u0435\u043F\u0435\u0440\u044C \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435 \u0434\u0440\u043E\u043D \u043D\u0430 \u043A\u0430\u0436\u0434\u043E\u043C \u0443\u0433\u043B\u0443, \u0447\u0442\u043E\u0431\u044B \u043D\u043E\u0441 \u0432\u0441\u0435\u0433\u0434\u0430 \u0441\u043C\u043E\u0442\u0440\u0435\u043B \u043F\u043E \u0445\u043E\u0434\u0443 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F. \u041A\u043E\u0433\u0434\u0430 \u043E\u043D \u043B\u0435\u0442\u0438\u0442 \u043A \u0432\u0430\u043C, \u043B\u0435\u0432\u043E \u0438 \u043F\u0440\u0430\u0432\u043E \u043C\u0435\u043D\u044F\u044E\u0442\u0441\u044F \u043C\u0435\u0441\u0442\u0430\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694536
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u043B\u0438\u043D\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694537
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u043A\u0443\u0431, \u0430 \u043D\u0435 \u043D\u0430 \u0434\u0440\u043E\u043D, \u0438 \u043B\u0435\u0442\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u043E \u043A \u043D\u0435\u043C\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694538
    m_Localized: "\u041B\u0435\u0442\u0438\u0442\u0435 \u043A \u043A\u0443\u0431\u0443 \u043F\u0435\u0440\u0435\u0434 \u0441\u0442\u043E\u043B\u0431\u043E\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694539
    m_Localized: "\u041E\u0431\u043B\u0435\u0442\u0438\u0442\u0435 \u0441\u0442\u043E\u043B\u0431 \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0435, \u043D\u043E\u0441\u043E\u043C \u043A \u0441\u0442\u043E\u043B\u0431\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694540
    m_Localized: "\u0422\u0435\u043F\u0435\u0440\u044C \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0432 \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043D\u043E\u0441 \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043D\u0430 \u0441\u0442\u043E\u043B\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694541
    m_Localized: "\u041E\u0431\u043B\u0451\u0442 \u0441\u0442\u043E\u043B\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694542
    m_Localized: "\u041E\u0431\u043B\u0435\u0442\u0438\u0442\u0435 \u0441\u0442\u043E\u043B\u0431 \u043F\u043E \u043A\u0440\u0443\u0433\u0443 \u0432 5 \u043C \u043E\u0442 \u043D\u0435\u0433\u043E, \u0432\u0441\u0451 \u0432\u0440\u0435\u043C\u044F \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u044F \u043D\u043E\u0441 \u0434\u0440\u043E\u043D\u0430 \u043D\u0430 \u0441\u0442\u043E\u043B\u0431\u0435. \u0417\u0430\u0442\u0435\u043C \u043F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u0432 \u0434\u0440\u0443\u0433\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u041D\u0443\u0436\u043D\u044B \u043E\u0431\u0430 \u0441\u0442\u0438\u043A\u0430 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E: \u043E\u0434\u0438\u043D \u0441\u043C\u0435\u0449\u0430\u0435\u0442 \u0434\u0440\u043E\u043D \u0432\u0431\u043E\u043A, \u0434\u0440\u0443\u0433\u043E\u0439 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694543
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0434\u043E \u0441\u0442\u043E\u043B\u0431\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694544
    m_Localized: "\u0415\u0441\u043B\u0438 \u043A\u0440\u0443\u0433 \u0440\u0430\u0441\u0442\u0451\u0442, \u0447\u0443\u0442\u044C \u043F\u043E\u0434\u0430\u0439\u0442\u0435 \u0434\u0440\u043E\u043D \u043A \u0441\u0442\u043E\u043B\u0431\u0443; \u0435\u0441\u043B\u0438 \u0441\u0436\u0438\u043C\u0430\u0435\u0442\u0441\u044F, \u043E\u0442\u043E\u0439\u0434\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694545
    m_Localized: "\u041D\u043E\u0441 \u043D\u0430 \u0441\u0442\u043E\u043B\u0431"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694546
    m_Localized: "\u041F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435 \u043B\u0435\u0432\u044B\u043C \u0441\u0442\u0438\u043A\u043E\u043C \u0432 \u0442\u043E\u043C \u0436\u0435 \u0442\u0435\u043C\u043F\u0435, \u0432 \u043A\u0430\u043A\u043E\u043C \u0441\u043C\u0435\u0449\u0430\u0435\u0442\u0435\u0441\u044C \u043F\u0440\u0430\u0432\u044B\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694547
    m_Localized: "\u041F\u0440\u043E\u0439\u0434\u0438\u0442\u0435 \u0447\u0435\u0440\u0435\u0437 \u043A\u0443\u0431 \u043C\u0435\u0436\u0434\u0443 \u0441\u0442\u043E\u043B\u0431\u0430\u043C\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694550
    m_Localized: "\u0412\u043E\u0441\u044C\u043C\u0451\u0440\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694553
    m_Localized: "\u041D\u0430\u0447\u0438\u043D\u0430\u0439\u0442\u0435 \u043A\u0430\u0436\u0434\u044B\u0439 \u043A\u0440\u0443\u0433 \u0438\u0437 \u0441\u0440\u0435\u0434\u043D\u0435\u0433\u043E \u043A\u0443\u0431\u0430 \u043D\u0430 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438; \u0431\u044B\u0441\u0442\u0440\u044B\u0439 \u0432\u0445\u043E\u0434 \u0434\u0435\u043B\u0430\u0435\u0442 \u043A\u0440\u0443\u0433 \u0448\u0438\u0440\u043E\u043A\u0438\u043C."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694556
    m_Localized: "\u0412\u0437\u043B\u0435\u0442\u0438\u0442\u0435 \u0438 \u043E\u0442\u043E\u0439\u0434\u0438\u0442\u0435 \u043D\u0430\u0437\u0430\u0434 \u0432 \u043A\u0443\u0431; \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 15 \u0441\u0435\u043A\u0443\u043D\u0434 \u043D\u043E\u0441\u043E\u043C \u043A \u0441\u0435\u0431\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694557
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0438 \u0437\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u043D\u0430\u0434 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u043E\u0439"
    m_Metadata:
