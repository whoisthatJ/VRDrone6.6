      m_Items: []
  - m_Id: 2872961921057
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u044B\u0439 \u0442\u0440\u0451\u0445\u043B\u043E\u043F\u0430\u0441\u0442\u043D\u043E\u0439 \u0432\u0438\u043D\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921058
    m_Localized: "\u041F\u043E\u043B\u043D\u043E\u0440\u0430\u0437\u043C\u0435\u0440\u043D\u0430\u044F \u044D\u043A\u0448\u043D-\u043A\u0430\u043C\u0435\u0440\u0430 \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u043F\u043B\u0430\u0441\u0442\u0438\u043D\u0435: \u043A\u0438\u043D\u0435\u043C\u0430\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0447\u043D\u0430\u044F \u0441\u044A\u0451\u043C\u043A\u0430, \u0431\u043E\u043B\u044C\u0448\u0435 \u0432\u0435\u0441\u0430 \u0438 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921059
    m_Localized: "\u041D\u0435\u0431\u043E\u043B\u044C\u0448\u0430\u044F HD-\u043A\u0430\u043C\u0435\u0440\u0430 \u0434\u043B\u044F 3\" \u0441\u0431\u043E\u0440\u043E\u043A."
    m_Metadata:
      m_Items: []
