    m_Metadata:
      m_Items: []
  - m_Id: 2872970309657
    m_Localized: "\u0418\u043D\u0435\u0440\u0446\u0438\u044F \u043C\u043E\u0442\u043E\u0440\u043E\u0432"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309658
    m_Localized: "\u041F\u0440\u043E\u0441\u0430\u0434\u043A\u0430 \u0431\u0430\u0442\u0430\u0440\u0435\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309659
    m_Localized: "\u041C\u0435\u043D\u044C\u0448\u0435 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435 = \u043B\u0435\u0433\u0447\u0435 \u0438 \u0431\u044B\u0441\u0442\u0440\u0435\u0435. \u0411\u043E\u043B\u044C\u0448\u0435 \u0438\u043D\u0435\u0440\u0446\u0438\u044F \u043C\u043E\u0442\u043E\u0440\u043E\u0432 = \u043C\u044F\u0433\u0447\u0435 \u0438 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u0435\u0435 \u043E\u0442\u043A\u043B\u0438\u043A \u043D\u0430 \u0433\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309660
    m_Localized: "\u041F\u043E\u0437\u044B\u0432\u043D\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309661
    m_Localized: "\u041F\u043E\u043A\u0430\u0437\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u0432 \u0442\u0430\u0431\u043B\u0438\u0446\u0435 \u0440\u0435\u043A\u043E\u0440\u0434\u043E\u0432 \u0438 \u0434\u0440\u0443\u0433\u0438\u043C \u043F\u0438\u043B\u043E\u0442\u0430\u043C \u043E\u043D\u043B\u0430\u0439\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309662
    m_Localized: "\u041F\u0443\u0431\u043B\u0438\u043A\u043E\u0432\u0430\u0442\u044C \u0432\u0440\u0435\u043C\u044F \u043A\u0440\u0443\u0433\u043E\u0432 \u043E\u043D\u043B\u0430\u0439\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309663
    m_Localized: "\u0412\u043A\u043B: \u043B\u0443\u0447\u0448\u0438\u0439 \u043A\u0440\u0443\u0433 \u043A\u0430\u0436\u0434\u043E\u0439 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043D\u043D\u043E\u0439 \u0433\u043E\u043D\u043A\u0438 \u043D\u0430 \u0432\u0441\u0442\u0440\u043E\u0435\u043D\u043D\u043E\u0439 \u0442\u0440\u0430\u0441\u0441\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u0432 \u043E\u043D\u043B\u0430\u0439\u043D-\u0442\u0430\u0431\u043B\u0438\u0446\u0443 (\u0430\u043D\u043E\u043D\u0438\u043C\u043D\u044B\u0439 \u0432\u0445\u043E\u0434)."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309664
