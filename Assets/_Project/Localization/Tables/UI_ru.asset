    m_Localized: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0432\u0435\u0434\u0440\u043E 3 \u0442\u043E\u0447\u043D\u043E \u0441\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634635
    m_Localized: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0432\u0435\u0434\u0440\u043E 4 \u0442\u043E\u0447\u043D\u043E \u0441\u043F\u0435\u0440\u0435\u0434\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634636
    m_Localized: "\u0422\u0440\u0430\u0432\u0435\u0440\u0441: \u0447\u0435\u0442\u044B\u0440\u0435 \u0432\u0435\u0434\u0440\u0430 \u0432 \u0440\u044F\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634637
    m_Localized: "\u0427\u0435\u0442\u044B\u0440\u0435 \u0432\u0435\u0434\u0440\u0430 \u0441\u0442\u043E\u044F\u0442 \u0432 \u0440\u044F\u0434, \u0432\u0441\u0435 \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 2 \u043C. \u0421\u043C\u0435\u0449\u0430\u0439\u0442\u0435\u0441\u044C \u0432\u0431\u043E\u043A \u0432\u0434\u043E\u043B\u044C \u0440\u044F\u0434\u0430, \u043D\u0430 \u043E\u0434\u043D\u043E\u0439 \u0432\u044B\u0441\u043E\u0442\u0435 \u0438 \u043D\u0430 \u043E\u0434\u043D\u043E\u043C \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0438, \u0438 \u0441\u043D\u0438\u043C\u0430\u0439\u0442\u0435 \u043A\u0430\u0436\u0434\u043E\u0435 \u0442\u043E\u0447\u043D\u043E \u0441\u043F\u0435\u0440\u0435\u0434\u0438. \u0414\u0440\u043E\u043D \u043D\u0435 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634638
    m_Localized: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0432\u0435\u0434\u0440\u043E, \u043E\u0431\u0440\u0430\u0449\u0451\u043D\u043D\u043E\u0435 \u043A \u0432\u0430\u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634639
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435 \u043E\u0431\u043B\u0451\u0442 \u0441\u0442\u043E\u0439\u043A\u0438 \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0435\u0435 \u0432\u0435\u0434\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634640
    m_Localized: "\u041E\u0440\u0431\u0438\u0442\u0430: \u0447\u0435\u0442\u044B\u0440\u0435 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0441\u0442\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634641
    m_Localized: "\u041D\u0430 \u0441\u0442\u043E\u0439\u043A\u0435 \u0447\u0435\u0442\u044B\u0440\u0435 \u0432\u0435\u0434\u0440\u0430, \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u043D\u0430 \u043A\u0430\u0436\u0434\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u041E\u0431\u043B\u0435\u0442\u0430\u0439\u0442\u0435 \u0435\u0451 \u043F\u043E \u0447\u0430\u0441\u043E\u0432\u043E\u0439 \u0441\u0442\u0440\u0435\u043B\u043A\u0435 \u0432 5 \u043C, \u0434\u0435\u0440\u0436\u0430 \u043A\u0430\u043C\u0435\u0440\u0443 \u043D\u0430 \u0441\u0442\u043E\u0439\u043A\u0435, \u0438 \u0441\u043D\u0438\u043C\u0430\u0439\u0442\u0435 \u043A\u0430\u0436\u0434\u043E\u0435 \u0432\u0435\u0434\u0440\u043E, \u043A\u043E\u0433\u0434\u0430 \u043E\u043A\u0430\u0436\u0435\u0442\u0435\u0441\u044C \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634642
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u044F \u0434\u043E \u0441\u0442\u043E\u0439\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634643
    m_Localized: "\u0415\u0441\u043B\u0438 \u043A\u0440\u0443\u0433 \u0440\u0430\u0441\u0442\u0451\u0442, \u0447\u0443\u0442\u044C \u043F\u043E\u0434\u0430\u0439\u0442\u0435 \u0434\u0440\u043E\u043D \u043A \u0441\u0442\u043E\u0439\u043A\u0435; \u0435\u0441\u043B\u0438 \u0441\u0436\u0438\u043C\u0430\u0435\u0442\u0441\u044F, \u043E\u0442\u043E\u0439\u0434\u0438\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634644
    m_Localized: "\u041A\u0430\u043C\u0435\u0440\u0430 \u043D\u0430 \u0441\u0442\u043E\u0439\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634645
    m_Localized: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0432\u0435\u0434\u0440\u043E \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 2 \u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634646
    m_Localized: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0432\u0435\u0434\u0440\u043E \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 4 \u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634647
    m_Localized: "\u0421\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0432\u0435\u0434\u0440\u043E \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 6 \u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634648
    m_Localized: "\u0421\u043D\u0438\u0437\u044C\u0442\u0435\u0441\u044C \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u0432\u0435\u0434\u0440\u043E \u043D\u0430 4 \u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634649
    m_Localized: "\u0421\u043F\u0438\u0440\u0430\u043B\u044C: \u0432\u0432\u0435\u0440\u0445 \u0438 \u0432\u043D\u0438\u0437 \u0432\u043E\u043A\u0440\u0443\u0433 \u0432\u044B\u0448\u043A\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634650
    m_Localized: "\u0412\u0451\u0434\u0440\u0430 \u0437\u0430\u043A\u0440\u0435\u043F\u043B\u0435\u043D\u044B \u043D\u0430 \u0432\u044B\u0448\u043A\u0435 \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 2 \u043C, 4 \u043C, 6 \u043C \u0438 4 \u043C, \u043A\u0430\u0436\u0434\u043E\u0435 \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u0432 \u0441\u0432\u043E\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u041F\u043E\u0434\u043D\u0438\u043C\u0438\u0442\u0435\u0441\u044C \u0432\u043E\u043A\u0440\u0443\u0433 \u0432\u044B\u0448\u043A\u0438 \u0434\u043E \u0432\u0435\u0440\u0445\u0430 \u0438 \u0441\u043F\u0443\u0441\u0442\u0438\u0442\u0435\u0441\u044C \u0441 \u0434\u0440\u0443\u0433\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B, \u0441\u043D\u0438\u043C\u0430\u044F \u043A\u0430\u0436\u0434\u043E\u0435 \u0432\u0435\u0434\u0440\u043E \u0441\u043F\u0435\u0440\u0435\u0434\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634651
    m_Localized: "\u041A\u0430\u043C\u0435\u0440\u0430 \u043D\u0430 \u0432\u044B\u0448\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634652
    m_Localized: "\u041D\u0430\u0431\u0438\u0440\u0430\u0439\u0442\u0435 \u0432\u044B\u0441\u043E\u0442\u0443 \u0438 \u043F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435 \u043E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E, \u043F\u043E\u043D\u0435\u043C\u043D\u043E\u0433\u0443: \u0432\u044B\u0448\u043A\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u043E\u0441\u0442\u0430\u0432\u0430\u0442\u044C\u0441\u044F \u0432 \u0446\u0435\u043D\u0442\u0440\u0435 \u043A\u0430\u0434\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634653
    m_Localized: "\u0417\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u043D\u0430\u0434 \u0432\u0435\u0434\u0440\u043E\u043C 1, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0441\u0442\u0440\u043E\u0433\u043E \u0432\u043D\u0438\u0437 \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634654
    m_Localized: "\u0417\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u043D\u0430\u0434 \u0432\u0435\u0434\u0440\u043E\u043C 2, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0441\u0442\u0440\u043E\u0433\u043E \u0432\u043D\u0438\u0437 \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634655
    m_Localized: "\u0417\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u043D\u0430\u0434 \u0432\u0435\u0434\u0440\u043E\u043C 3, \u043F\u043E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0441\u0442\u0440\u043E\u0433\u043E \u0432\u043D\u0438\u0437 \u0438 \u0441\u0444\u043E\u0442\u043E\u0433\u0440\u0430\u0444\u0438\u0440\u0443\u0439\u0442\u0435 \u0435\u0433\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634656
    m_Localized: "\u0420\u0430\u0437\u0432\u0435\u0434\u043A\u0430: \u0437\u0430\u0433\u043B\u044F\u043D\u0443\u0442\u044C \u0432 \u0442\u0440\u0438 \u0432\u0435\u0434\u0440\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634657
    m_Localized: "\u0422\u0440\u0438 \u0432\u0435\u0434\u0440\u0430 \u043B\u0435\u0436\u0430\u0442 \u043D\u0430 \u0437\u0435\u043C\u043B\u0435 \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u043E\u0439 \u0432\u0432\u0435\u0440\u0445. \u041F\u0440\u043E\u043B\u0435\u0442\u0438\u0442\u0435 \u043D\u0430\u0434 \u043A\u0430\u0436\u0434\u044B\u043C \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 3 \u043C \u0438\u043B\u0438 \u0432\u044B\u0448\u0435, \u043D\u0430\u043A\u043B\u043E\u043D\u0438\u0442\u0435 \u043A\u0430\u043C\u0435\u0440\u0443 \u0441\u0442\u0440\u043E\u0433\u043E \u0432\u043D\u0438\u0437, \u0432\u044B\u0432\u0435\u0434\u0438\u0442\u0435 \u0432\u0435\u0434\u0440\u043E \u0432 \u0446\u0435\u043D\u0442\u0440 \u043A\u0430\u0434\u0440\u0430 \u0438 \u0441\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u0441\u043D\u0438\u043C\u043E\u043A. \u041F\u0440\u0438 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438 \u043F\u0440\u0438\u0431\u043B\u0438\u0437\u044C\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634658
    m_Localized: "\u041B\u0435\u0442\u0438\u0442\u0435 \u043A \u0434\u0430\u043B\u044C\u043D\u0435\u043C\u0443 \u043A\u0443\u0431\u0443 \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 \u0435\u0433\u043E 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634659
    m_Localized: "\u0411\u0430\u0442\u0430\u0440\u0435\u044F \u0441\u0430\u0434\u0438\u0442\u0441\u044F: \u043B\u0435\u0442\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u043E \u043D\u0430\u0437\u0430\u0434 \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C \u043D\u0430\u0434 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634660
    m_Localized: "\u041E\u0434\u0438\u043D \u043C\u043E\u0442\u043E\u0440 \u043E\u0441\u043B\u0430\u0431: \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u0441\u0435\u0439\u0447\u0430\u0441, \u043C\u044F\u0433\u043A\u043E, \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634661
    m_Localized: "\u0410\u0432\u0430\u0440\u0438\u0439\u043D\u044B\u0435 \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634662
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u043F\u043E\u043B\u0451\u0442\u0435 \u0441\u043B\u0443\u0447\u0430\u044E\u0442\u0441\u044F \u043E\u0442\u043A\u0430\u0437\u044B. \u041A\u043E\u0433\u0434\u0430 \u0434\u043E\u043B\u0435\u0442\u0438\u0442\u0435 \u0434\u043E \u0434\u0430\u043B\u044C\u043D\u0435\u0433\u043E \u043A\u0443\u0431\u0430, \u043F\u0440\u043E\u0441\u044F\u0434\u0435\u0442 \u0431\u0430\u0442\u0430\u0440\u0435\u044F: \u0441\u0440\u0430\u0437\u0443 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0439\u0442\u0435\u0441\u044C. \u041D\u0430\u0434 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u043E\u0439 \u043E\u0441\u043B\u0430\u0431\u043D\u0435\u0442 \u043C\u043E\u0442\u043E\u0440: \u0441\u0430\u0434\u0438\u0442\u0435\u0441\u044C \u043D\u0435\u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E \u0438 \u043C\u044F\u0433\u043A\u043E. \u0427\u0438\u0442\u0430\u0439\u0442\u0435 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043A\u0443 \u0432\u0432\u0435\u0440\u0445\u0443 \u044D\u043A\u0440\u0430\u043D\u0430 \u0438 \u043D\u0435 \u0441\u043F\u0435\u0448\u0438\u0442\u0435 \u0431\u043E\u043B\u044C\u0448\u0435, \u0447\u0435\u043C \u043D\u0443\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634663
    m_Localized: "\u0421\u043E \u0441\u043B\u0430\u0431\u044B\u043C \u043C\u043E\u0442\u043E\u0440\u043E\u043C \u0434\u0440\u043E\u043D \u0441\u043D\u0438\u0436\u0430\u0435\u0442\u0441\u044F \u0431\u044B\u0441\u0442\u0440\u0435\u0435: \u0434\u043E\u0431\u0430\u0432\u043B\u044F\u0439\u0442\u0435 \u0433\u0430\u0437 \u0440\u0430\u043D\u044C\u0448\u0435 \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E."
    m_Metadata:
      m_Items: []
