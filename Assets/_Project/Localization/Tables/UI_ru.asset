    m_Metadata:
      m_Items: []
  - m_Id: 258319929307138
    m_Localized: "\u041B\u0435\u0442\u043D\u0438\u0439 \u0434\u0435\u043D\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 266269578227712
    m_Localized: "\u042D\u041A\u0421\u041F\u041E \u0421\u043F\u0440\u0438\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 266269620170752
    m_Localized: "\u042D\u041A\u0421\u041F\u041E \u041F\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 266269620170753
    m_Localized: "\u0414\u043B\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0449\u0438\u0445, 1,2 \u043A\u043C: \u0432\u0432\u0435\u0440\u0445 \u043F\u043E \u044E\u0436\u043D\u043E\u0439 \u0430\u043B\u043B\u0435\u0435, \u0447\u0435\u0440\u0435\u0437 \u043F\u0430\u0432\u0438\u043B\u044C\u043E\u043D \u0432 \u0435\u0433\u043E \u0434\u0432\u043E\u0440, \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0444\u0435\u0440\u044B \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 3 \u043C, \u0441\u043B\u0430\u043B\u043E\u043C \u0432 \u043F\u0430\u0440\u043A\u0435 \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043F\u043E \u0430\u043B\u043B\u0435\u0435. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F \u0440\u0435\u0436\u0438\u043C \u0442\u0440\u0435\u043D\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 266269620170754
    m_Localized: "\u0414\u043B\u044F \u043E\u043F\u044B\u0442\u043D\u044B\u0445, 2,2 \u043A\u043C: \u043F\u0440\u044B\u0436\u043E\u043A \u0432\u043E \u0434\u0432\u043E\u0440, \u0441\u043F\u0438\u0440\u0430\u043B\u044C \u0432\u043E\u043A\u0440\u0443\u0433 \u0441\u0444\u0435\u0440\u044B \u0434\u043E 90 \u043C, \u043F\u0438\u043A\u0435 \u0432 \u043F\u0430\u0440\u043A, \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u043D\u0430\u044F \u0434\u0443\u0433\u0430 \u043F\u043E \u043A\u043E\u043B\u044C\u0446\u0435\u0432\u043E\u0439 \u0434\u043E\u0440\u043E\u0433\u0435 \u0438 \u0432\u0442\u043E\u0440\u043E\u0439 \u0434\u0432\u043E\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 274119067168768
    m_Localized: "<color=#ff4a3d>\u0412\u042B \u041F\u041E\u041A\u0418\u0414\u0410\u0415\u0422\u0415 \u0417\u041E\u041D\u0423 \u041F\u041E\u041B\u0401\u0422\u041E\u0412 - \u0420\u0410\u0417\u0412\u0415\u0420\u041D\u0418\u0422\u0415\u0421\u042C</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 274119125889024
    m_Localized: "\u0421\u0412\u041E\u0411\u041E\u0414\u041D\u042B\u0419 \u041F\u041E\u041B\u0401\u0422   {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 274119125889025
    m_Localized: "F / D-pad \u0432\u0432\u0435\u0440\u0445: \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0430\u044F \u0442\u043E\u0447\u043A\u0430   T: \u0441\u0431\u0440\u043E\u0441"
    m_Metadata:
      m_Items: []
