  - m_Id: 6775319980408833
    m_Localized: "\u041F\u0440\u043E\u043B\u0435\u0442\u0438\u0442\u0435 \u0432\u043E\u0441\u044C\u043C\u0451\u0440\u043A\u0443 \u0432\u043E\u043A\u0440\u0443\u0433 \u0434\u0432\u0443\u0445 \u0441\u0442\u043E\u043B\u0431\u043E\u0432: \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u0432\u043E\u043A\u0440\u0443\u0433 \u043B\u0435\u0432\u043E\u0433\u043E, \u0447\u0435\u0440\u0435\u0437 \u043A\u0443\u0431 \u043F\u043E\u0441\u0435\u0440\u0435\u0434\u0438\u043D\u0435, \u0437\u0430\u0442\u0435\u043C \u0432\u043E\u043A\u0440\u0443\u0433 \u043F\u0440\u0430\u0432\u043E\u0433\u043E \u0432 \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443. \u0412\u044B\u0441\u043E\u0442\u0443 \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u043E\u0434\u0438\u043D\u0430\u043A\u043E\u0432\u043E\u0439 \u0432\u0435\u0441\u044C \u043F\u0443\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6775319980408834
    m_Localized: "\u041A\u0440\u0443\u0433 \u0432\u043E\u043A\u0440\u0443\u0433 \u043B\u0435\u0432\u043E\u0433\u043E \u0441\u0442\u043E\u043B\u0431\u0430"
    m_Metadata:
