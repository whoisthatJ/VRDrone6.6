  - m_Id: 2872970309728
    m_Localized: "\u041E\u0442\u043C\u0435\u043D\u0435\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309729
    m_Localized: "\u041A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u0430 \u043D\u0435 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043D\u0430: \u043D\u0430\u0439\u0434\u0435\u043D\u044B \u043D\u0435 \u0432\u0441\u0435 \u0447\u0435\u0442\u044B\u0440\u0435 \u043E\u0441\u0438 \u0441\u0442\u0438\u043A\u043E\u0432. \u041F\u043E\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435 \u0435\u0449\u0451 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309730
    m_Localized: "\u041A\u0430\u043B\u0438\u0431\u0440\u043E\u0432\u043A\u0430 \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0430 ({0}). \u0413\u0430\u0437 ch{1}, \u0440\u044B\u0441\u043A\u0430\u043D\u0438\u0435 ch{2}, \u0442\u0430\u043D\u0433\u0430\u0436 ch{3}, \u043A\u0440\u0435\u043D ch{4}{5}."
