  - m_Id: 397150372491264
    m_Localized: "\u0426\u0438\u0444\u0440\u043E\u0432\u043E\u0435 HD-\u0432\u0438\u0434\u0435\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 397150443794432
    m_Localized: "\u0426\u0438\u0444\u0440\u043E\u0432\u0430\u044F HD-\u043A\u0430\u043C\u0435\u0440\u0430 \u0438 \u044D\u0444\u0438\u0440\u043D\u044B\u0439 \u043C\u043E\u0434\u0443\u043B\u044C \u0441 \u0434\u0432\u0443\u043C\u044F \u0430\u043D\u0442\u0435\u043D\u043D\u0430\u043C\u0438 \u0432\u043C\u0435\u0441\u0442\u043E \u0430\u043D\u0430\u043B\u043E\u0433\u043E\u0432\u043E\u0439 \u043A\u0430\u043C\u0435\u0440\u044B \u0438 VTX: \u0447\u0438\u0441\u0442\u0430\u044F \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0430, \u0447\u0443\u0442\u044C \u0442\u044F\u0436\u0435\u043B\u0435\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 450717305270272
    m_Localized: "<color=#ff5ad8>\u041A\u0410\u0421\u0410\u041D\u0418\u0415 \u041A\u041E\u041B\u042C\u0426\u0410 +0,5 \u0441</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 450717380767744
    m_Localized: "\u0414\u043B\u044F \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0449\u0438\u0445, 1,5 \u043A\u043C: \u043F\u0440\u044B\u0436\u043E\u043A \u0432\u043E \u0434\u0432\u043E\u0440, \u043E\u0431\u043B\u0451\u0442 \u0441\u0444\u0435\u0440\u044B \u043D\u0430 3 \u043C, \u043F\u043E\u0434\u044A\u0451\u043C \u0432\u0435\u0440\u0442\u0438\u043A\u0430\u043B\u044C\u043D\u043E \u0441\u043A\u0432\u043E\u0437\u044C Holo Halo \u0438 \u043E\u0431\u0440\u0430\u0442\u043D\u043E \u043F\u043E \u043E\u0441\u0438. \u0420\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0443\u0435\u0442\u0441\u044F \u0440\u0435\u0436\u0438\u043C \u0442\u0440\u0435\u043D\u0435\u0440\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 450717380767745
    m_Localized: "\u0414\u043B\u044F \u043E\u043F\u044B\u0442\u043D\u044B\u0445, 2,9 \u043A\u043C: \u0447\u0435\u0440\u0435\u0437 \u0432\u0435\u0440\u0445 \u0441\u0444\u0435\u0440\u044B, \u0432\u043D\u0438\u0437 \u0441\u043A\u0432\u043E\u0437\u044C Holo Halo, \u043F\u0438\u043A\u0435 \u0441\u043E \u0441\u0442\u0435\u043B\u044B, \u043B\u0435\u0441\u0442\u043D\u0438\u0446\u0430, \u0441\u043F\u043B\u0438\u0442-S, \u043A\u043E\u043B\u044C\u0446\u0435\u0432\u0430\u044F \u0438 \u0432\u0442\u043E\u0440\u043E\u0439 \u0434\u0432\u043E\u0440."
    m_Metadata:
      m_Items: []
