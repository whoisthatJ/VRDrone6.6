    m_Localized: "\u0422\u0440\u0451\u0445\u043B\u043E\u043F\u0430\u0441\u0442\u043D\u043E\u0439 \u0432\u0438\u043D\u0442 \u0434\u043B\u044F toothpick."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921053
    m_Localized: "\u041F\u044F\u0442\u044C \u043B\u043E\u043F\u0430\u0441\u0442\u0435\u0439 \u0434\u043B\u044F \u043A\u043E\u043B\u0435\u0446: \u0442\u044F\u0433\u0430 \u0432 \u043C\u0430\u043B\u043E\u043C \u0434\u0438\u0441\u043A\u0435."
