  - m_Id: 6771039164694558
    m_Localized: "\u0421\u044F\u0434\u044C\u0442\u0435 \u043D\u0430 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u0443, \u043F\u043E-\u043F\u0440\u0435\u0436\u043D\u0435\u043C\u0443 \u043D\u043E\u0441\u043E\u043C \u043A \u0441\u0435\u0431\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694559
    m_Localized: "\u0412\u0438\u0441\u0435\u043D\u0438\u0435 \u0438 \u043F\u043E\u0441\u0430\u0434\u043A\u0430 \u043D\u043E\u0441\u043E\u043C \u043A \u0441\u0435\u0431\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694560
    m_Localized: "\u0414\u0440\u043E\u043D \u0441\u043C\u043E\u0442\u0440\u0438\u0442 \u043D\u0430 \u0432\u0430\u0441. \u0422\u0435\u043F\u0435\u0440\u044C \u0435\u0433\u043E \u043B\u0435\u0432\u043E \u0434\u043B\u044F \u0432\u0430\u0441 \u0441\u043F\u0440\u0430\u0432\u0430, \u0430 \u0441\u0442\u0438\u043A \u0432\u043F\u0435\u0440\u0451\u0434 \u0432\u0435\u0434\u0451\u0442 \u0435\u0433\u043E \u043A \u0432\u0430\u043C. \u0417\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u0432 \u043A\u0443\u0431\u0435 \u0438 \u0441\u044F\u0434\u044C\u0442\u0435, \u043D\u0435 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u044F \u0434\u0440\u043E\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694561
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u043D\u043E\u0441\u043E\u043C \u043A \u0441\u0435\u0431\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694562
    m_Localized: "\u041D\u0435 \u0440\u0430\u0437\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435 \u0434\u0440\u043E\u043D, \u0447\u0442\u043E\u0431\u044B \u0441\u0442\u0430\u043B\u043E \u043F\u0440\u043E\u0449\u0435: \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u0438\u0435 \u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F \u0441\u0442\u0438\u043A\u043E\u043C, \u0434\u0443\u043C\u0430\u0439\u0442\u0435 \u0441 \u043C\u0435\u0441\u0442\u0430 \u0434\u0440\u043E\u043D\u0430."
    m_Metadata:
