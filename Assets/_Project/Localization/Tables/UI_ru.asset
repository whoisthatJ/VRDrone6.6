  - m_Id: 6778737641914368
    m_Localized: "\u0421\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043F\u0440\u044F\u043C\u043E \u0432 \u0432\u0435\u0434\u0440\u043E: \u043A\u0430\u043C\u0435\u0440\u0430 \u0434\u043E\u043B\u0436\u043D\u0430 \u0431\u044B\u0442\u044C \u043D\u0430\u043F\u0440\u043E\u0442\u0438\u0432 \u0435\u0433\u043E \u0433\u043E\u0440\u043B\u043E\u0432\u0438\u043D\u044B, \u0430 \u043D\u0435 \u0441\u0431\u043E\u043A\u0443."
