  - m_Id: 2872961921045
    m_Localized: "\u041C\u043E\u043C\u0435\u043D\u0442\u043D\u044B\u0439 6S-\u043C\u043E\u0442\u043E\u0440 \u0434\u043B\u044F 3.5\" \u043A\u043E\u043B\u0435\u0446."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921046
    m_Localized: "\u0413\u043E\u043D\u043E\u0447\u043D\u044B\u0439 \u043C\u043E\u0442\u043E\u0440 \u043D\u0430 4S: \u0440\u0435\u0437\u043A\u0438\u0439 \u0438 \u0431\u044B\u0441\u0442\u0440\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921047
    m_Localized: "\u0424\u0440\u0438\u0441\u0442\u0430\u0439\u043B-\u043C\u043E\u0442\u043E\u0440 \u043D\u0430 6S: \u043C\u043E\u043C\u0435\u043D\u0442 \u0438 \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921048
    m_Localized: "\u0411\u043E\u043B\u0435\u0435 \u043B\u0451\u0433\u043A\u0438\u0439 \u043C\u043E\u0442\u043E\u0440 \u043D\u0430 4S, \u043F\u043B\u0430\u0432\u043D\u044B\u0439 \u0438 \u044D\u043A\u043E\u043D\u043E\u043C\u0438\u0447\u043D\u044B\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921049
    m_Localized: "\u0414\u0430\u043B\u044C\u043D\u043E\u0431\u043E\u0439\u043D\u044B\u0439 6S-\u043C\u043E\u0442\u043E\u0440 \u0434\u043B\u044F 7\" \u0432\u0438\u043D\u0442\u043E\u0432."
