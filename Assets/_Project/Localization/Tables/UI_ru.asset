    m_Localized: "\u041D\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u043B\u0438 \u0441\u043D\u0438\u0437\u044C\u0442\u0435\u0441\u044C \u0434\u043E 1 \u043C \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 5 \u0441\u0435\u043A\u0443\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061767
    m_Localized: "\u041D\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u043B\u0438 \u0441\u043D\u0438\u0437\u044C\u0442\u0435\u0441\u044C \u0434\u043E 3 \u043C \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 5 \u0441\u0435\u043A\u0443\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061768
    m_Localized: "\u041D\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u043B\u0438 \u0441\u043D\u0438\u0437\u044C\u0442\u0435\u0441\u044C \u0434\u043E 5 \u043C \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 5 \u0441\u0435\u043A\u0443\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061769
    m_Localized: "\u041D\u0430\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u043B\u0438 \u0441\u043D\u0438\u0437\u044C\u0442\u0435\u0441\u044C \u0434\u043E 2 \u043C \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0439\u0442\u0435 5 \u0441\u0435\u043A\u0443\u043D\u0434"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061770
    m_Localized: "\u0421\u0442\u0443\u043F\u0435\u043D\u0438 \u0432\u044B\u0441\u043E\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061771
    m_Localized: "\u041F\u0440\u043E\u043B\u0435\u0442\u0438\u0442\u0435 \u0447\u0435\u0442\u044B\u0440\u0435 \u0432\u044B\u0441\u043E\u0442\u044B \u043E\u0434\u043D\u0443 \u0437\u0430 \u0434\u0440\u0443\u0433\u043E\u0439: 1 \u043C, 3 \u043C, 5 \u043C \u0438 2 \u043C. \u041D\u0430 \u043A\u0430\u0436\u0434\u043E\u0439 \u043F\u0440\u043E\u0434\u0435\u0440\u0436\u0438\u0442\u0435\u0441\u044C 5 \u0441\u0435\u043A\u0443\u043D\u0434 \u0432\u043D\u0443\u0442\u0440\u0438 \u0435\u0451 \u043A\u0443\u0431\u0430, \u043D\u0435 \u0441\u043C\u0435\u0449\u0430\u044F\u0441\u044C \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u044B. \u0417\u0430\u0442\u0435\u043C \u0441\u044F\u0434\u044C\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061772
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u043D\u0430\u0434 \u043F\u043B\u043E\u0449\u0430\u0434\u043A\u043E\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061773
    m_Localized: "\u0412 \u044D\u0442\u043E\u043C \u0443\u043F\u0440\u0430\u0436\u043D\u0435\u043D\u0438\u0438 \u0434\u0432\u0438\u0433\u0430\u0435\u0442\u0441\u044F \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A: \u043F\u0440\u0430\u0432\u044B\u0439 \u0431\u043E\u043B\u044C\u0448\u043E\u0439 \u043F\u0430\u043B\u0435\u0446 \u0434\u0435\u0440\u0436\u0438\u0442\u0435 \u043D\u0435\u043F\u043E\u0434\u0432\u0438\u0436\u043D\u043E."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061774
    m_Localized: "\u0412\u0437\u043B\u0435\u0442\u0438\u0442\u0435 \u0438 \u0437\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u0432 \u043A\u0443\u0431\u0435 \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 2 \u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061775
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u043F\u043E\u043B\u043D\u044B\u0439 \u043E\u0431\u043E\u0440\u043E\u0442 \u0432\u043F\u0440\u0430\u0432\u043E \u043D\u0430 \u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061776
    m_Localized: "\u0421\u0434\u0435\u043B\u0430\u0439\u0442\u0435 \u043F\u043E\u043B\u043D\u044B\u0439 \u043E\u0431\u043E\u0440\u043E\u0442 \u0432\u043B\u0435\u0432\u043E \u043D\u0430 \u043C\u0435\u0441\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061777
    m_Localized: "\u041F\u0438\u0440\u0443\u044D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061778
    m_Localized: "\u0417\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u0432 \u043C\u0430\u043B\u0435\u043D\u044C\u043A\u043E\u043C \u043A\u0443\u0431\u0435 \u0438 \u0440\u0430\u0437\u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u0434\u0440\u043E\u043D \u043D\u0430 \u043F\u043E\u043B\u043D\u044B\u0439 \u043E\u0431\u043E\u0440\u043E\u0442 \u0432\u043F\u0440\u0430\u0432\u043E, \u0437\u0430\u0442\u0435\u043C \u043D\u0430 \u043F\u043E\u043B\u043D\u044B\u0439 \u043E\u0431\u043E\u0440\u043E\u0442 \u0432\u043B\u0435\u0432\u043E, \u043D\u0435 \u0432\u044B\u0445\u043E\u0434\u044F \u0438\u0437 \u043A\u0443\u0431\u0430. \u041F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0434\u0440\u043E\u043D \u0442\u043E\u043B\u044C\u043A\u043E \u043B\u0435\u0432\u044B\u0439 \u0441\u0442\u0438\u043A."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061779
    m_Localized: "\u0423\u0434\u0435\u0440\u0436\u0430\u043D\u0438\u0435 \u0432 \u043A\u0443\u0431\u0435 \u043F\u0440\u0438 \u043F\u043E\u0432\u043E\u0440\u043E\u0442\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061780
    m_Localized: "\u041F\u043E\u0432\u043E\u0440\u0430\u0447\u0438\u0432\u0430\u0439\u0442\u0435 \u043C\u0435\u0434\u043B\u0435\u043D\u043D\u043E. \u0415\u0441\u043B\u0438 \u0434\u0440\u043E\u043D \u0443\u0445\u043E\u0434\u0438\u0442 \u0432 \u0441\u0442\u043E\u0440\u043E\u043D\u0443, \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435 \u043F\u043E\u0432\u043E\u0440\u043E\u0442, \u0432\u0435\u0440\u043D\u0438\u0442\u0435 \u0435\u0433\u043E \u0438 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u0439\u0442\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061781
    m_Localized: "\u0412\u0437\u043B\u0435\u0442\u0438\u0442\u0435 \u0438 \u0437\u0430\u0432\u0438\u0441\u043D\u0438\u0442\u0435 \u0432 \u0431\u043B\u0438\u0436\u043D\u0435\u043C \u043A\u0443\u0431\u0435 \u043D\u0430 \u0432\u044B\u0441\u043E\u0442\u0435 2 \u043C"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061782
    m_Localized: "\u041F\u0440\u043E\u043B\u0435\u0442\u0438\u0442\u0435 15 \u043C \u0432\u043F\u0435\u0440\u0451\u0434 \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C \u0432 \u0434\u0430\u043B\u044C\u043D\u0435\u043C \u043A\u0443\u0431\u0435 \u043D\u0430 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061783
    m_Localized: "\u0412\u0435\u0440\u043D\u0438\u0442\u0435\u0441\u044C \u0438 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0435\u0441\u044C \u0432 \u0431\u043B\u0438\u0436\u043D\u0435\u043C \u043A\u0443\u0431\u0435 \u043D\u0430 3 \u0441\u0435\u043A\u0443\u043D\u0434\u044B"
