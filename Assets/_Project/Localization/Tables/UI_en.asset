      m_Items: []
  - m_Id: 2872961921033
    m_Localized: 65 mm ducted whoop. Bumps off walls, flies indoors.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921034
    m_Localized: '2.5" ducted cinewhoop: soft, stable, slow.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921035
    m_Localized: Featherweight 3" toothpick. Light, nimble, fragile.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921036
    m_Localized: '3.5" ducted cine rig on 6S: lifts a small HD camera.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921037
    m_Localized: Race-proven true-X. Low drag, slim arms, light.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921038
    m_Localized: 'Ultralight race frame. Thinner arms: fast, but bends.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921039
    m_Localized: Tough stretched-X for freestyle. Thick 6 mm arms.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921040
    m_Localized: 'Deadcat geometry: props out of the camera view.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921041
    m_Localized: 7" long-range cruiser. Efficient, stable, far.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921042
    m_Localized: Whoop motor for 1S.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921043
    m_Localized: Tiny 2S motor for 2.5" ducts.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921044
    m_Localized: 3" toothpick motor for 4S.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921045
    m_Localized: Torquey 6S motor for 3.5" ducts.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921046
    m_Localized: '4S race motor: punchy and fast.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921047
    m_Localized: '6S freestyle motor: torque and top end.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921048
    m_Localized: Lighter 4S motor, smooth and efficient.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921049
    m_Localized: Long-range 6S motor for 7" props.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921050
    m_Localized: Whoop props.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921051
    m_Localized: Ducted tri-blade.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921052
    m_Localized: Toothpick tri-blade.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921053
    m_Localized: 'Five blades for ducts: thrust in a small disc.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921054
    m_Localized: 'Race tri-blade: grip and top speed.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921055
    m_Localized: Freestyle tri-blade, durable.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921056
    m_Localized: 'Low pitch: efficient and smooth, less top speed.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921057
    m_Localized: Long-range tri-blade.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921058
    m_Localized: 'Full-size action camera on the top plate: cinematic footage, more weight and drag.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921059
    m_Localized: Small HD camera for 3" rigs.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921060
    m_Localized: Bright LED strips along the frame. Night racing look.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921061
    m_Localized: 'Tall stubby-free antenna: better range, a little drag.'
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921062
    m_Localized: Plain 3K carbon weave.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921063
    m_Localized: Carbon with gold-anodised plate edges and standoffs.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921064
    m_Localized: Printed tiger-stripe skin on the plates.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921065
    m_Localized: Matte black everything.
    m_Metadata:
      m_Items: []
  - m_Id: 2872961921066
    m_Localized: Accent colour for motors, props and LEDs.
