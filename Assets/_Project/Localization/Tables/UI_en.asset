    m_Metadata:
      m_Items: []
  - m_Id: 274119134277632
    m_Localized: Expo Free Flight
    m_Metadata:
      m_Items: []
  - m_Id: 274119134277633
    m_Localized: 'No gates: fly anywhere within 1.2 km of the sphere and up to 150 m. F / D-pad up switches between the south plaza, above the sphere, the park and the ring road; T resets.'
    m_Metadata:
      m_Items: []
  - m_Id: 332879047421952
    m_Localized: Expo Classic Sprint
    m_Metadata:
      m_Items: []
  - m_Id: 332879093559296
