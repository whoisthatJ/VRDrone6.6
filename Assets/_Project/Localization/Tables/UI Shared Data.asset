  - m_Id: 6926043418722304
    m_Key: One full roll
    m_Metadata:
      m_Items: []
  - m_Id: 6926043418722305
    m_Key: One full flip
    m_Metadata:
      m_Items: []
  - m_Id: 6926043422916608
    m_Key: Check ride
    m_Metadata:
      m_Items: []
  - m_Id: 6926043422916609
    m_Key: 'Everything from the course in one flight, in acro mode: three gates out, a climb to 12 m, one roll and one flip, two gates back, and a landing on the pad you started from. The time counts. Passing this flight completes the course and opens your certificate.'
    m_Metadata:
      m_Items: []
  - m_Id: 6926043422916610
    m_Key: 'Time: gold 80 s, silver 120 s, bronze 170 s'
