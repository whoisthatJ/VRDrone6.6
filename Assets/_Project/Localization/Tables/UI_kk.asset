  - m_Id: 2872970309726
    m_Localized: "\u049A\u043E\u0441\u044B\u043C\u0448\u0430: \u041A\u0410\u041C\u0415\u0420\u0410 \u041A\u04E8\u0420\u0406\u041D\u0406\u0421\u0406 \u04AF\u0448\u0456\u043D \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0493\u044B\u0448\u0442\u044B \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u044B\u043F (\u043D\u0435\u043C\u0435\u0441\u0435 \u0431\u0430\u0442\u044B\u0440\u043C\u0430\u043D\u044B \u0431\u0430\u0441\u044B\u043F), \u04B1\u0441\u0442\u0430\u043F \u0442\u04B1\u0440\u044B\u04A3\u044B\u0437.\n(\u049A\u0430\u0436\u0435\u0442 \u0431\u043E\u043B\u043C\u0430\u0441\u0430, \u04E9\u0442\u043A\u0456\u0437\u0456\u043F \u0436\u0456\u0431\u0435\u0440\u0456\u04A3\u0456\u0437.)"
