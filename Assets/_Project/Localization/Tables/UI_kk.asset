    m_Localized: "\u041E\u04A3 \u0436\u0430\u049B \u0431\u0430\u0493\u0430\u043D\u0430 \u0430\u0439\u043D\u0430\u043B\u0430\u0441\u044B\u043D\u0434\u0430\u0493\u044B \u0448\u0435\u04A3\u0431\u0435\u0440"
