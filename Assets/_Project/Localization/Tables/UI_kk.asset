  - m_Id: 6753576817524738
    m_Localized: "\u041E\u0440\u044B\u043D\u0434\u044B \u04B1\u0441\u0442\u0430\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524739
    m_Localized: "\u041E\u0440\u044B\u043D\u0434\u044B \u04B1\u0441\u0442\u0430\u0443: \u0441\u0442\u0438\u043A\u0442\u0435\u0440\u0434\u0456 \u0436\u0456\u0431\u0435\u0440\u0441\u0435\u04A3\u0456\u0437, \u0434\u0440\u043E\u043D \u043E\u0440\u043D\u044B\u043D\u0434\u0430 \u049B\u0430\u043B\u0430\u0434\u044B. \u04B0\u0448\u0443 \u043A\u0435\u0437\u0456\u043D\u0434\u0435 G \u043A\u04E9\u043C\u0435\u043A\u0448\u0456\u043D\u0456 \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0430\u0434\u044B, L \u0441\u043E\u04A3\u0493\u044B \u04B1\u0448\u0443\u0434\u044B \u049B\u0430\u0439\u0442\u0430 \u043A\u04E9\u0440\u0441\u0435\u0442\u0435\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524740
    m_Localized: "\u04D8\u0437\u0456\u0440\u0433\u0435 \u0435\u0448\u0442\u0435\u04A3\u0435 \u0436\u0430\u0437\u044B\u043B\u043C\u0430\u0493\u0430\u043D"
    m_Metadata:
      m_Items: []
