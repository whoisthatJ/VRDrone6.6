    m_Localized: "\u0411\u0456\u0440 \u049B\u0430\u0442\u0430\u0440\u0434\u0430 \u0430\u043B\u0442\u044B \u0436\u0430\u043B\u0430\u0443 \u0442\u04B1\u0440. \u041E\u043B\u0430\u0440\u0434\u044B\u04A3 \u0430\u0440\u0430\u0441\u044B\u043C\u0435\u043D \u0438\u0440\u0435\u043B\u0435\u04A3\u0434\u0435\u043F \u04E9\u0442\u0456\u04A3\u0456\u0437: \u0431\u0456\u0440\u0456\u043D\u0448\u0456\u0441\u0456\u043D\u0456\u04A3 \u043E\u04A3 \u0436\u0430\u0493\u044B\u043D\u0430\u043D, \u043A\u0435\u043B\u0435\u0441\u0456\u0441\u0456\u043D\u0456\u04A3 \u0441\u043E\u043B \u0436\u0430\u0493\u044B\u043D\u0430\u043D, \u043E\u0441\u044B\u043B\u0430\u0439 \u0436\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u044B\u043F, \u0430\u043B\u044B\u0441 \u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u04A3\u044B\u0437. \u04D8\u0440 \u0431\u04B1\u0440\u044B\u043B\u044B\u0441\u0442\u044B \u0435\u0440\u0442\u0435\u0440\u0435\u043A \u0431\u0430\u0441\u0442\u0430\u04A3\u044B\u0437; \u0434\u0440\u043E\u043D \u0442\u04AF\u0437\u0443\u043B\u0435\u0433\u0435\u043D\u043D\u0435\u043D \u043A\u0435\u0439\u0456\u043D \u0434\u0435 \u0441\u044B\u0440\u0493\u0438 \u0431\u0435\u0440\u0435\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 6782631549861908
    m_Localized: "\u0422\u04E9\u043C\u0435\u043D \u04B1\u0448\u044B\u04A3\u044B\u0437: 1-\u049B\u0430\u049B\u043F\u0430 \u0430\u0440\u049B\u044B\u043B\u044B"
