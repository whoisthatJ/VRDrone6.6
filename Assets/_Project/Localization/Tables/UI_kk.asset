  - m_Id: 397150372491264
    m_Localized: "\u0426\u0438\u0444\u0440\u043B\u044B\u049B HD \u0431\u0435\u0439\u043D\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 397150443794432
    m_Localized: "\u0410\u043D\u0430\u043B\u043E\u0433\u0442\u044B\u049B \u043A\u0430\u043C\u0435\u0440\u0430 \u043C\u0435\u043D VTX \u043E\u0440\u043D\u044B\u043D\u0430 \u0435\u043A\u0456 \u0430\u043D\u0442\u0435\u043D\u043D\u0430\u0441\u044B \u0431\u0430\u0440 \u0446\u0438\u0444\u0440\u043B\u044B\u049B HD \u043A\u0430\u043C\u0435\u0440\u0430 \u0436\u04D9\u043D\u0435 \u044D\u0444\u0438\u0440 \u043C\u043E\u0434\u0443\u043B\u0456: \u0442\u0430\u0437\u0430 \u0441\u0443\u0440\u0435\u0442, \u0441\u04D9\u043B \u0430\u0443\u044B\u0440\u044B\u0440\u0430\u049B."
    m_Metadata:
      m_Items: []
  - m_Id: 450717305270272
    m_Localized: "<color=#ff5ad8>\u0421\u0410\u049A\u0418\u041D\u0410\u0492\u0410 \u0422\u0418\u0414\u0406\u04A2\u0406\u0417 +0,5 \u0441</color>"
    m_Metadata:
      m_Items: []
  - m_Id: 450717380767744
    m_Localized: "\u0411\u0430\u0441\u0442\u0430\u0443\u0448\u044B, 1,5 \u043A\u043C: \u0430\u0443\u043B\u0430\u0493\u0430 \u0441\u0435\u043A\u0456\u0440\u0443, \u0441\u0444\u0435\u0440\u0430\u043D\u044B 3 \u043C \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0435 \u0430\u0439\u043D\u0430\u043B\u0443, Holo Halo \u0430\u0440\u049B\u044B\u043B\u044B \u0442\u0456\u043A \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0443 \u0436\u04D9\u043D\u0435 \u043E\u0441\u044C\u043F\u0435\u043D \u043A\u0435\u0440\u0456. \u0416\u0430\u0442\u0442\u044B\u049B\u0442\u044B\u0440\u0443\u0448\u044B \u043D\u04B1\u0441\u049B\u0430\u0443\u044B \u04B1\u0441\u044B\u043D\u044B\u043B\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 450717380767745
    m_Localized: "\u0422\u04D9\u0436\u0456\u0440\u0438\u0431\u0435\u043B\u0456, 2,9 \u043A\u043C: \u0441\u0444\u0435\u0440\u0430\u043D\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435\u043D, Holo Halo \u0430\u0440\u049B\u044B\u043B\u044B \u0442\u04E9\u043C\u0435\u043D, \u0441\u0442\u0435\u043B\u0430 \u04AF\u0441\u0442\u0456\u043D\u0435\u043D \u049B\u04B1\u043B\u0434\u0438\u043B\u0430\u0443, \u0431\u0430\u0441\u043F\u0430\u043B\u0434\u0430\u049B, \u0441\u043F\u043B\u0438\u0442-S, \u0430\u0439\u043D\u0430\u043B\u043C\u0430 \u0436\u043E\u043B \u0436\u04D9\u043D\u0435 \u0435\u043A\u0456\u043D\u0448\u0456 \u0430\u0443\u043B\u0430."
    m_Metadata:
      m_Items: []
