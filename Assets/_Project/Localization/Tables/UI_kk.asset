    m_Localized: "\u0411\u0456\u0440 \u043C\u0435\u0437\u0433\u0456\u043B\u0434\u0435 \u0430\u0437-\u0430\u0437\u0434\u0430\u043D \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u043F \u04D9\u0440\u0456 \u0431\u04B1\u0440\u044B\u043B\u044B\u04A3\u044B\u0437: \u043C\u04B1\u043D\u0430\u0440\u0430 \u0441\u0443\u0440\u0435\u0442\u0442\u0456\u04A3 \u043E\u0440\u0442\u0430\u0441\u044B\u043D\u0434\u0430 \u049B\u0430\u043B\u0443\u044B \u043A\u0435\u0440\u0435\u043A."
