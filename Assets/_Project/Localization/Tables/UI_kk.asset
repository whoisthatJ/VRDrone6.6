  - m_Id: 2872957726756
    m_Localized: "\u0421\u0410\u041B\u041C\u0410\u0492\u042B: {0} g"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726757
    m_Localized: "\u0421\u0410\u041B\u041C\u0410\u0492\u042B: +{0} g"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726758
    m_Localized: "\xAB{0}\xBB \u0441\u0430\u049B\u0442\u0430\u043B\u0434\u044B \u0436\u04D9\u043D\u0435 \u04B1\u0448\u0443\u0493\u0430 \u0442\u0430\u04A3\u0434\u0430\u043B\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726759
    m_Localized: "\u0421\u0410\u049A\u0422\u0410\u041B\u0492\u0410\u041D: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726760
    m_Localized: "\u049A\u043E\u0441\u044B\u043C\u0448\u0430\u043B\u0430\u0440: {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726761
    m_Localized: "\u041C\u0430\u0441\u0441\u0430\u0441\u044B {0} g     \u0418\u043D\u0435\u0440\u0446\u0438\u044F (\u0442\u0430\u043D\u0433\u0430\u0436/\u0431\u0430\u0493\u044B\u0442/\u043A\u0440\u0435\u043D) {1} / {2} / {3} (x10^-6 kg m\xB2)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726762
    m_Localized: "\u0418\u0456\u043D\u0434\u0435\u0440 {0} \xD7 {1} mm     \u041A\u0435\u0434\u0435\u0440\u0433\u0456 (\u0431\u04AF\u0439\u0456\u0440/\u04AF\u0441\u0442\u0456/\u0430\u043B\u0434\u044B) {2} / {3} / {4} kg/m"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726763
    m_Localized: "\u0422\u043E\u043B\u044B\u049B \u0433\u0430\u0437: {1} V \u043A\u0435\u0437\u0456\u043D\u0434\u0435 \u04D9\u0440 \u043C\u043E\u0442\u043E\u0440\u0493\u0430 {0} A,  {2} \u0430\u0439\u043D/\u043C\u0438\u043D,  \u04D9\u0440 \u043C\u043E\u0442\u043E\u0440\u0493\u0430 {3} g"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726764
    m_Localized: "\u0412\u0438\u043D\u0442 \u049B\u0430\u0434\u0430\u043C\u044B \u0431\u043E\u0439\u044B\u043D\u0448\u0430 \u0436\u044B\u043B\u0434\u0430\u043C\u0434\u044B\u049B {0} m/s     \u041C\u043E\u0442\u043E\u0440\u0434\u044B\u04A3 \u04AF\u0434\u0435\u0443\u0456 {1} ms     \u0411\u0430\u0493\u044B\u0442 \u043C\u043E\u043C\u0435\u043D\u0442\u0456/\u0442\u0430\u0440\u0442\u0443 {2} m"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726765
    m_Localized: "\u041C\u0430\u043A\u0441. \u0436\u044B\u043B\u0434\u0430\u043C\u0434\u044B\u049B {0} km/h     T/W {1}:1     \u049A\u0430\u043B\u049B\u0443 {2} %, {3} \u043C\u0438\u043D     \u041C\u043E\u0442\u043E\u0440\u0434\u044B\u04A3 \u0448\u0435\u043A\u0442\u0456 \u0442\u0435\u043C\u043F. ~{4} \xB0C (\u0431\u0430\u0493\u0430\u043B\u0430\u0443)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726766
    m_Localized: "PID \u0442\u0430\u043D\u0433\u0430\u0436 P {0} I {1} D {2}    \u0431\u0430\u0493\u044B\u0442 P {3}"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726767
    m_Localized: "\u0413\u0410\u0417   \u0422\u0410\u0420\u0422\u0423 (\u0431\u0430\u0440\u043B\u044B\u0493\u044B)   \u0422\u041E\u041A/\u043C\u043E\u0442\u043E\u0440   \u0410\u0419\u041D/\u041C\u0418\u041D"
    m_Metadata:
      m_Items: []
  - m_Id: 2872957726768
    m_Localized: "\u041A\u04E9\u0440\u0441\u0435\u0442\u043A\u0456\u0448\u0442\u0435\u0440 \u0431\u04E9\u043B\u0448\u0435\u043A\u0442\u0435\u0440\u0434\u0435\u043D \u0435\u0441\u0435\u043F\u0442\u0435\u043B\u0435\u0434\u0456: \u0436\u04AF\u043A\u0442\u0435\u043C\u0435\u0434\u0435\u0433\u0456 \u0431\u0430\u0442\u0430\u0440\u0435\u044F\u0434\u0430\u043D \u0436\u04B1\u043C\u044B\u0441 \u0456\u0441\u0442\u0435\u0439\u0442\u0456\u043D \u043C\u043E\u0442\u043E\u0440 \u043C\u0435\u043D \u0432\u0438\u043D\u0442\u0442\u0456\u04A3 \u0436\u04B1\u043C\u044B\u0441 \u043D\u04AF\u043A\u0442\u0435\u0441\u0456, \u043A\u0435\u0434\u0435\u0440\u0433\u0456 \u0430\u0443\u0434\u0430\u043D\u0434\u0430\u0440\u044B \u0436\u04D9\u043D\u0435 \u0431\u04E9\u043B\u0448\u0435\u043A\u0442\u0435\u0440\u0434\u0456\u04A3 \u043C\u0430\u0441\u0441\u0430\u0441\u044B. \u0421\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u0434\u0430 \u0434\u04D9\u043B \u043E\u0441\u044B \u0441\u0430\u043D\u0434\u0430\u0440 \u04B1\u0448\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
