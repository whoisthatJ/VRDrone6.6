    m_Metadata:
      m_Items: []
  - m_Id: 6782631549861891
    m_Localized: "\u0410\u043B\u044B\u0441 \u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u043F, \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448\u0442\u0430\u0440\u0434\u044B \u04E9\u0448\u0456\u0440\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6782631549861892
    m_Localized: "\u049A\u0430\u043B\u044B\u049B\u0442\u0430\u0443, \u0441\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u0431\u0456\u0440 \u049B\u0430\u0442\u0430\u0440\u0434\u0430\u0493\u044B \u04AF\u0448 \u049B\u0430\u049B\u043F\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6782631549861893
    m_Localized: "\u0414\u0440\u043E\u043D\u043D\u044B\u04A3 \u04E9\u0437 \u043A\u0430\u043C\u0435\u0440\u0430\u0441\u044B \u0430\u0440\u049B\u044B\u043B\u044B \u0430\u043B\u0493\u0430\u0448\u049B\u044B \u04B1\u0448\u0443\u044B\u04A3\u044B\u0437. \u0414\u0440\u043E\u043D \u04E9\u0437\u0456\u043D \u0442\u04AF\u0437\u0443\u043B\u0435\u0439\u0434\u0456, \u0431\u0456\u0440\u0430\u049B \u0431\u0438\u0456\u043A\u0442\u0456\u0433\u0456 \u043C\u0435\u043D \u043E\u0440\u043D\u044B\u043D \u0435\u0448\u0442\u0435\u04A3\u0435 \u04B1\u0441\u0442\u0430\u043C\u0430\u0439\u0434\u044B: \u0435\u043D\u0434\u0456 \u0431\u04B1\u043B \u0441\u0456\u0437\u0434\u0456\u04A3 \u0436\u04B1\u043C\u044B\u0441\u044B\u04A3\u044B\u0437. \u049A\u043E\u0440\u0430\u043F\u0442\u0430 \u049B\u0430\u043B\u044B\u049B\u0442\u0430\u043F, \u04AF\u0448 \u049B\u0430\u049B\u043F\u0430 \u0430\u0440\u049B\u044B\u043B\u044B \u0442\u0443\u0440\u0430 \u04B1\u0448\u044B\u043F \u04E9\u0442\u0456\u043F, \u0430\u043B\u044B\u0441 \u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6782631549861894
    m_Localized: "\u0414\u04B1\u0440\u044B\u0441 \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0435\u0433\u0456 \u0443\u0430\u049B\u044B\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6782631549861895
    m_Localized: "\u0411\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0456 \u0433\u0430\u0437 \u04B1\u0441\u0442\u0430\u0439\u0434\u044B: \u0430\u0437-\u0430\u0437\u0434\u0430\u043D \u049B\u043E\u0437\u0493\u0430\u043F, \u0430\u0441\u0442\u044B\u04A3\u044B\u0437\u0434\u0430\u0493\u044B \u0436\u0435\u0440\u0433\u0435 \u0435\u043C\u0435\u0441, \u0430\u043B\u044B\u0441\u049B\u0430 \u049B\u0430\u0440\u0430\u04A3\u044B\u0437."
