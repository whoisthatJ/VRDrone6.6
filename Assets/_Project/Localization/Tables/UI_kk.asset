    m_Localized: "\u041E\u0441\u044B \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442 \u043C\u044B\u043D\u0430\u043D\u044B \u0440\u0430\u0441\u0442\u0430\u0439\u0434\u044B:"
    m_Metadata:
