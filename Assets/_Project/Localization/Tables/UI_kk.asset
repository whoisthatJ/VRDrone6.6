    m_Localized: "\u0421\u043E\u04A3\u0493\u044B \u04B1\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524742
    m_Localized: "\u041A\u0430\u043C\u0435\u0440\u0430\u043B\u044B \u0434\u0440\u043E\u043D 900 \u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524743
    m_Localized: "\u041A\u0430\u043C\u0435\u0440\u0430\u043B\u044B \u0434\u0440\u043E\u043D 250 \u0433"
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524744
    m_Localized: "\u0416\u0435\u0442\u043A\u0456\u0437\u0443 \u0434\u0440\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524745
    m_Localized: "\u041E\u049B\u0443 \u0434\u0440\u043E\u043D\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524746
    m_Localized: "\u0422\u04B1\u0440\u0430\u049B\u0442\u0430\u043D\u0434\u044B\u0440\u044B\u043B\u0493\u0430\u043D \u043A\u0430\u043C\u0435\u0440\u0430\u0441\u044B \u0431\u0430\u0440 \u0436\u0438\u043D\u0430\u043B\u043C\u0430\u043B\u044B \u0434\u0440\u043E\u043D. \u041E\u0440\u043D\u044B\u043D \u04E9\u0437\u0456 \u04B1\u0441\u0442\u0430\u0439\u0434\u044B, \u0436\u0435\u043B\u0434\u0435 \u043E\u0440\u043D\u044B\u049B\u0442\u044B, \u0430\u0443\u0430\u0434\u0430 \u0436\u0430\u0440\u0442\u044B \u0441\u0430\u0493\u0430\u0442."
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524747
    m_Localized: "\u041A\u0430\u043C\u0435\u0440\u0430\u0441\u044B \u0431\u0430\u0440 \u0448\u0430\u0493\u044B\u043D \u0434\u0440\u043E\u043D, 250 \u0433-\u043D\u0430\u043D \u0436\u0435\u04A3\u0456\u043B. \u0416\u0435\u04A3\u0456\u043B \u04D9\u0440\u0456 \u0442\u044B\u043D\u044B\u0448; \u0436\u0435\u043B \u043E\u043D\u044B \u0442\u0435\u0437\u0456\u0440\u0435\u043A \u049B\u043E\u0437\u0493\u0430\u0439\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524748
    m_Localized: "2,5 \u043A\u0433, 1 \u043A\u0433 \u049B\u043E\u0440\u0430\u043F\u0442\u044B \u0442\u0430\u0441\u044B\u043F, \u049B\u0430\u0436\u0435\u0442\u0442\u0456 \u0436\u0435\u0440\u0433\u0435 \u049B\u043E\u044E\u0493\u0430 \u0430\u0440\u043D\u0430\u043B\u0493\u0430\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 6753576817524749
    m_Localized: "\u0412\u0438\u043D\u0442 \u049B\u043E\u0440\u0493\u0430\u043D\u044B\u0448\u044B, \u0435\u043A\u0456 \u043A\u0430\u043C\u0435\u0440\u0430\u0441\u044B \u0436\u04D9\u043D\u0435 \u049B\u0430\u0448\u044B\u049B\u0442\u044B\u049B \u0434\u0430\u0442\u0447\u0438\u043A\u0442\u0435\u0440\u0456 \u0431\u0430\u0440 \u0448\u0430\u0493\u044B\u043D \u0434\u0440\u043E\u043D: \u043E\u043D\u044B \u0431\u0430\u0493\u0434\u0430\u0440\u043B\u0430\u043C\u0430\u043B\u0430\u0439\u0434\u044B."
    m_Metadata:
      m_Items: []
