    m_Localized: "\u049A\u043E\u0441\u0443 \u043D\u0435 \u0430\u043B\u044B\u043F \u0442\u0430\u0441\u0442\u0430\u0443 \u04AF\u0448\u0456\u043D \u043A\u0430\u0440\u0442\u043E\u0447\u043A\u0430\u043D\u044B \u0431\u0430\u0441\u044B\u04A3\u044B\u0437."
