    m_Localized: "\u0415\u043A\u0456 \u0436\u0430\u043B\u0430\u0443\u0434\u044B \u0430\u0439\u043D\u0430\u043B\u0430 \u0431\u0456\u0440 \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0435 \u0441\u043E\u043F\u0430\u049B\u0448\u0430 \u0431\u043E\u0439\u044B\u043C\u0435\u043D \u0435\u043A\u0456 \u0430\u0439\u043D\u0430\u043B\u044B\u043C \u04B1\u0448\u044B\u04A3\u044B\u0437. \u04B0\u0448\u0430\u049B \u0441\u0438\u044F\u049B\u0442\u044B \u0431\u04B1\u0440\u044B\u043B\u044B\u04A3\u044B\u0437: \u0431\u04B1\u0440\u044B\u043B\u044B\u0441\u049B\u0430 \u049B\u0430\u0440\u0430\u0439 \u0435\u04A3\u043A\u0435\u0439\u0456\u043F, \u0431\u0456\u0440 \u043C\u0435\u0437\u0433\u0456\u043B\u0434\u0435 \u0442\u04B1\u043C\u0441\u044B\u049B\u0442\u044B \u0431\u04B1\u0440\u044B\u04A3\u044B\u0437, \u0441\u043E\u043D\u0434\u0430 \u043A\u0430\u043C\u0435\u0440\u0430 \u04D9\u0440\u0434\u0430\u0439\u044B\u043C \u04B1\u0448\u0443 \u0431\u0430\u0493\u044B\u0442\u044B\u043D\u0430 \u049B\u0430\u0440\u0430\u0439\u0434\u044B."
