  - m_Id: 6918525095247884
    m_Localized: "\u0410\u043A\u0440\u043E \u0430\u0439\u043D\u0430\u043B\u044B\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6918525095247885
    m_Localized: "\u0428\u0435\u04A3\u0431\u0435\u0440 \u0431\u043E\u0439\u044B\u043D\u0434\u0430 \u0442\u04E9\u0440\u0442 \u049B\u0430\u049B\u043F\u0430, \u0435\u043A\u0456 \u0430\u0439\u043D\u0430\u043B\u044B\u043C, \u0430\u043A\u0440\u043E \u0440\u0435\u0436\u0438\u043C\u0456\u043D\u0434\u0435. \u0428\u0435\u04A3\u0431\u0435\u0440\u0434\u0456 \u043E\u04A3\u0493\u0430 \u049B\u0430\u0440\u0430\u0439 \u04B1\u0448\u044B\u04A3\u044B\u0437: \u0431\u0430\u0442\u044B\u0441, \u0441\u043E\u043B\u0442\u04AF\u0441\u0442\u0456\u043A, \u0448\u044B\u0493\u044B\u0441, \u043E\u04A3\u0442\u04AF\u0441\u0442\u0456\u043A \u049B\u0430\u049B\u043F\u0430. \u0411\u0456\u0440\u049B\u0430\u043B\u044B\u043F\u0442\u044B, \u0436\u0435\u04A3\u0456\u043B \u0436\u044B\u043B\u0434\u0430\u043C\u0434\u044B\u049B\u0442\u044B \u04B1\u0441\u0442\u0430\u04A3\u044B\u0437: \u0442\u0430\u0437\u0430 \u0430\u0439\u043D\u0430\u043B\u044B\u043C \u0436\u044B\u043B\u0434\u0430\u043C \u0430\u0439\u043D\u0430\u043B\u044B\u043C\u043D\u0430\u043D \u043C\u0430\u04A3\u044B\u0437\u0434\u044B\u0440\u0430\u049B."
    m_Metadata:
      m_Items: []
