  - m_Id: 2872970309674
    m_Localized: "\u0416\u044B\u043B\u0430\u043D \u0430\u0440\u0435\u043D\u0430\u0441\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309675
    m_Localized: "\u0421\u0442\u0430\u0434\u0438\u043E\u043D\u0434\u0430\u0493\u044B \u0436\u0430\u0440\u044B\u0441 \u0442\u0440\u0430\u0441\u0441\u0430\u0441\u044B: \u049B\u043E\u043D\u0443 \u0430\u043B\u0430\u04A3\u0434\u0430\u0440\u044B\u043D \u0430\u0439\u043D\u0430\u043B\u0430\u0442\u044B\u043D \u0456\u043B\u043C\u0435\u043A\u0442\u0435\u0440, \u043E\u0440\u0442\u0430\u04A3\u0493\u044B \u043D\u04AF\u043A\u0442\u0435\u0434\u0435\u0433\u0456 \u0441\u0435\u0433\u0456\u0437\u0434\u0456\u043A \u0436\u04D9\u043D\u0435 \u0442\u04E9\u0440\u0442 \u043A\u04E9\u043F\u0456\u0440."
