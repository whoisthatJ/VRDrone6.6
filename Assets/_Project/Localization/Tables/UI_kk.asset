      m_Items: []
  - m_Id: 2872966115384
    m_Localized: "\u041E\u043D\u043B\u0430\u0439\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2872966115385
    m_Localized: "\u0422\u0456\u043D\u0442\u0443\u0456\u0440, \u043F\u0435\u0440\u043D\u0435\u0442\u0430\u049B\u0442\u0430 \u043D\u0435\u043C\u0435\u0441\u0435 \u0433\u0435\u0439\u043C\u043F\u0430\u0434. \u04B0\u0448\u0443 \u043A\u0435\u0437\u0456\u043D\u0434\u0435: V \u043A\u0430\u043C\u0435\u0440\u0430\u043D\u044B \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0430\u0434\u044B, Esc \u043E\u0441\u044B\u043D\u0434\u0430 \u049B\u0430\u0439\u0442\u0430\u0440\u0430\u0434\u044B."
