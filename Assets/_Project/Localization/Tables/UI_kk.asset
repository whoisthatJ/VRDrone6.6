  - m_Id: 6918525095247892
    m_Localized: "\u041C\u04D9\u0440\u0435 \u0430\u043B\u0430\u04A3\u0448\u0430\u0441\u044B\u043D\u0430 \u049B\u043E\u043D\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6918525095247893
    m_Localized: "\u0416\u0430\u0440\u044B\u0441 \u0441\u044B\u0437\u044B\u0493\u044B: \u0448\u0438\u043A\u0430\u043D\u0430 \u043C\u0435\u043D \u0448\u04B1\u0493\u044B\u043B \u0431\u04B1\u0440\u044B\u043B\u044B\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 6918525099442176
    m_Localized: "\u0410\u043B\u0442\u044B \u049B\u0430\u049B\u043F\u0430: \u0448\u0438\u043A\u0430\u043D\u0430, \u0441\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u043A\u0435\u043B\u0433\u0435\u043D \u0436\u0430\u049B\u049B\u0430 \u049B\u0430\u0440\u0430\u0439 \u0448\u04B1\u0493\u044B\u043B \u0431\u04B1\u0440\u044B\u043B\u044B\u0441. \u0416\u04B1\u043B\u0434\u044B\u0437\u0434\u0430\u0440\u0434\u044B \u0443\u0430\u049B\u044B\u0442 \u0448\u0435\u0448\u0435\u0434\u0456. \u0411\u04B1\u0440\u044B\u043B\u044B\u0441\u049B\u0430 \u043A\u0435\u04A3\u0456\u043D\u0435\u043D \u043A\u0456\u0440\u0456\u043F, \u043E\u043D\u044B\u04A3 \u0456\u0448\u043A\u0456 \u0436\u0430\u0493\u044B\u043D\u0430 \u0436\u0430\u049B\u044B\u043D \u04E9\u0442\u0456\u04A3\u0456\u0437, \u04D9\u0440\u0456 \u04E9\u0442\u0456\u043F \u0436\u0430\u0442\u049B\u0430\u043D \u049B\u0430\u049B\u043F\u0430\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D\u0433\u0456 \u049B\u0430\u049B\u043F\u0430\u0493\u0430 \u049B\u0430\u0440\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6918525099442177
    m_Localized: "\u0423\u0430\u049B\u044B\u0442: \u0430\u043B\u0442\u044B\u043D 40 \u0441, \u043A\u04AF\u043C\u0456\u0441 55 \u0441, \u049B\u043E\u043B\u0430 75 \u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 6918525099442178
    m_Localized: "\u0423\u0430\u049B\u044B\u0442 \u0431\u04B1\u0440\u044B\u043B\u044B\u0441\u0442\u0430\u0440\u0434\u0430 \u0436\u043E\u0493\u0430\u043B\u0430\u0434\u044B: \u0430\u0437\u044B\u0440\u0430\u049B \u0442\u0435\u0436\u0435\u043F, \u049B\u0430\u049B\u043F\u0430\u043D\u044B\u04A3 \u0456\u0448\u0456\u043D\u0434\u0435 \u0435\u043C\u0435\u0441, \u043E\u0493\u0430\u043D \u0436\u0435\u0442\u043F\u0435\u0439 \u0431\u04B1\u0440\u044B\u043B\u0430 \u0431\u0430\u0441\u0442\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6918525099442179
    m_Localized: "\u0416\u0430\u049B\u044B\u043D \u04B1\u0448\u0443: \u0431\u0435\u0441 \u0441\u0430\u04A3\u044B\u043B\u0430\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6918525099442180
    m_Localized: "\u0411\u0456\u0440 \u049B\u0430\u0442\u0430\u0440\u0434\u0430 \u0431\u0435\u0441 \u0441\u0430\u04A3\u044B\u043B\u0430\u0443, \u04D9\u0440\u049B\u0430\u0439\u0441\u044B\u0441\u044B \u0430\u043B\u0434\u044B\u04A3\u0493\u044B\u0441\u044B\u043D\u0430\u043D \u043A\u0456\u0448\u0456\u0440\u0435\u043A: \u0435\u043D\u0456 3 \u043C-\u0434\u0435\u043D 1 \u043C-\u0433\u0435 \u0434\u0435\u0439\u0456\u043D. \u04D8\u0440\u049B\u0430\u0439\u0441\u044B\u0441\u044B\u043D\u044B\u04A3 \u043E\u0440\u0442\u0430\u0441\u044B\u043D\u0430\u043D \u04B1\u0448\u044B\u043F \u04E9\u0442\u0456\u04A3\u0456\u0437. \u0416\u0430\u049B\u0442\u0430\u0443\u0493\u0430 \u049B\u0430\u0442\u0442\u044B \u0441\u043E\u0493\u044B\u043B\u0443 \u04D9\u0440\u0435\u043A\u0435\u0442\u0442\u0456 \u0430\u044F\u049B\u0442\u0430\u0439\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6924680404140032
    m_Localized: "\u0411\u0438\u0456\u043A\u0442\u0456\u043A - \u0441\u0456\u0437\u0434\u0456\u04A3 \u049B\u0430\u0443\u0456\u043F\u0441\u0456\u0437\u0434\u0456\u0433\u0456\u04A3\u0456\u0437: \u04D9\u0440 \u0436\u0430\u04A3\u0430 \u049B\u0438\u043C\u044B\u043B\u0434\u044B \u0431\u0438\u0456\u043A\u0442\u0435\u043D \u0431\u0430\u0441\u0442\u0430\u04A3\u044B\u0437, \u0430\u043B \u0434\u0440\u043E\u043D \u0442\u04E9\u04A3\u043A\u0435\u0440\u0456\u043B\u0456\u043F \u0442\u04B1\u0440\u0493\u0430\u043D\u0434\u0430 \u0433\u0430\u0437\u0434\u044B \u0430\u0437\u0430\u0439\u0442\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
