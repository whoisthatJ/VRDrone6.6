  - m_Id: 6761043458785290
    m_Localized: "\u04B0\u0448\u044B\u043F \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0443, \u049B\u0430\u043B\u044B\u049B\u0442\u0430\u0443, \u049B\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6761043458785291
    m_Localized: "\u04B0\u0448\u044B\u043F \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u043F, 2 \u043C \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0435\u0433\u0456 \u043A\u04E9\u043A \u049B\u043E\u0440\u0430\u043F\u049B\u0430 \u043A\u0456\u0440\u0456\u04A3\u0456\u0437. \u041E\u043D\u044B\u04A3 \u0456\u0448\u0456\u043D\u0434\u0435 20 \u0441\u0435\u043A\u0443\u043D\u0434 \u0442\u04B1\u0440\u044B\u04A3\u044B\u0437. \u0421\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u0442\u04E9\u043C\u0435\u043D\u0434\u0435\u043F, \u04B1\u0448\u049B\u0430\u043D \u0430\u043B\u0430\u04A3\u0448\u0430\u04A3\u044B\u0437\u0493\u0430 \u049B\u043E\u043D\u044B\u04A3\u044B\u0437."
