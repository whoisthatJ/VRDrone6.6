    m_Localized: "\u0422\u04E9\u043C\u0435\u043D \u04B1\u0448\u044B\u04A3\u044B\u0437: 4-\u049B\u0430\u049B\u043F\u0430 \u0430\u0440\u049B\u044B\u043B\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6782631549861912
    m_Localized: "\u0422\u04E9\u043C\u0435\u043D \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0435 \u04B1\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6782631549861913
    m_Localized: "\u0411\u04AF\u043A\u0456\u043B \u0436\u043E\u043B\u0434\u044B \u0436\u0435\u0440\u0434\u0435\u043D \u0436\u0430\u0440\u0442\u044B \u043C\u0435\u0442\u0440 \u043C\u0435\u043D \u0431\u0456\u0440 \u0436\u0430\u0440\u044B\u043C \u043C\u0435\u0442\u0440 \u0430\u0440\u0430\u043B\u044B\u0493\u044B\u043D\u0434\u0430, \u0442\u04E9\u0440\u0442 \u0430\u043B\u0430\u0441\u0430 \u049B\u0430\u049B\u043F\u0430 \u0430\u0440\u049B\u044B\u043B\u044B \u04B1\u0448\u044B\u04A3\u044B\u0437. \u0411\u04B1\u043B \u043A\u04E9\u0440\u0456\u043D\u0456\u0441\u0442\u0435 \u0436\u0435\u0440 \u0442\u0435\u0437 \u0436\u0430\u049B\u044B\u043D\u0434\u0430\u0439\u0434\u044B: \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0456 \u0433\u0430\u0437\u0434\u044B \u0430\u0437-\u0430\u0437\u0434\u0430\u043D \u049B\u043E\u0437\u0493\u0430\u043F \u04B1\u0441\u0442\u0430\u04A3\u044B\u0437, \u043E\u043D\u044B \u049B\u0443\u0430\u043B\u0430\u043C\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6918525032333312
    m_Localized: "\u04B0\u0448\u044B\u043F \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u043F, \u0434\u0440\u043E\u043D\u0434\u044B \u049B\u043E\u0440\u0430\u043F \u0456\u0448\u0456\u043D\u0434\u0435 20 \u0441\u0435\u043A\u0443\u043D\u0434 \u04B1\u0441\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6918525095247872
    m_Localized: "\u0410\u043A\u0440\u043E \u0440\u0435\u0436\u0438\u043C\u0456\u043D\u0434\u0435 \u049B\u0430\u043B\u044B\u049B\u0442\u0430\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6918525095247873
    m_Localized: "\u0410\u043A\u0440\u043E \u0440\u0435\u0436\u0438\u043C\u0456: \u0434\u0440\u043E\u043D \u0435\u043D\u0434\u0456 \u04E9\u0437\u0456\u043D \u0442\u04AF\u0437\u0443\u043B\u0435\u043C\u0435\u0439\u0434\u0456. \u041E\u043B \u0441\u0456\u0437 \u049B\u0430\u043B\u0434\u044B\u0440\u0493\u0430\u043D \u0431\u04B1\u0440\u044B\u0448\u0442\u0430 \u049B\u0430\u043B\u0430\u0434\u044B, \u0441\u043E\u043D\u0434\u044B\u049B\u0442\u0430\u043D \u04D9\u0440 \u0435\u04A3\u043A\u0435\u044E\u0434\u0456 \u049B\u043E\u043B\u043C\u0435\u043D \u049B\u0430\u0439\u0442\u0430\u0440\u0443 \u043A\u0435\u0440\u0435\u043A. \u041E\u043D\u044B 3 \u043C \u049B\u043E\u0440\u0430\u043F\u0442\u044B\u04A3 \u0456\u0448\u0456\u043D\u0434\u0435 20 \u0441\u0435\u043A\u0443\u043D\u0434 \u04B1\u0441\u0442\u0430\u043F, \u0441\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u049B\u043E\u043D\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6918525095247874
    m_Localized: "\u049A\u043E\u0440\u0430\u043F \u0456\u0448\u0456\u043D\u0434\u0435 \u0435\u04A3 \u04B1\u0437\u0430\u049B \u0431\u043E\u043B\u0493\u0430\u043D \u0443\u0430\u049B\u044B\u0442"
    m_Metadata:
