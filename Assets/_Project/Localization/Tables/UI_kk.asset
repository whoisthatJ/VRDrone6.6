    m_Localized: "\u0410\u0448\u044B\u049B \u0436\u0430\u0440\u044B\u0441\u0442\u0430\u0440 \u0436\u043E\u049B. \u0422\u0456\u0437\u0456\u043C\u0434\u0456 \u0436\u0430\u04A3\u0430\u0440\u0442\u044B\u04A3\u044B\u0437, \u0436\u044B\u043B\u0434\u0430\u043C \u0436\u0430\u0440\u044B\u0441 \u0431\u0430\u0441\u0442\u0430\u04A3\u044B\u0437 \u043D\u0435\u043C\u0435\u0441\u0435 \u04E9\u0437 \u0436\u0430\u0440\u044B\u0441\u044B\u04A3\u044B\u0437\u0434\u044B \u0430\u0448\u044B\u04A3\u044B\u0437."
