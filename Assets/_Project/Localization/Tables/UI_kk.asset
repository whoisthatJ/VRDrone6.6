  - m_Id: 6771039164694550
    m_Localized: "\u0421\u0435\u0433\u0456\u0437\u0434\u0456\u043A"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694553
    m_Localized: "\u04D8\u0440 \u0448\u0435\u04A3\u0431\u0435\u0440\u0434\u0456 \u043E\u0440\u0442\u0430\u0434\u0430\u0493\u044B \u049B\u043E\u0440\u0430\u043F\u0442\u0430\u043D \u0431\u0430\u044F\u0443 \u0431\u0430\u0441\u0442\u0430\u04A3\u044B\u0437; \u0436\u044B\u043B\u0434\u0430\u043C \u043A\u0456\u0440\u0443 \u0448\u0435\u04A3\u0431\u0435\u0440\u0434\u0456 \u043A\u0435\u04A3\u0435\u0439\u0442\u0435\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694556
    m_Localized: "\u04B0\u0448\u044B\u043F \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u043F, \u0448\u0435\u0433\u0456\u043D\u0456\u043F \u049B\u043E\u0440\u0430\u043F\u049B\u0430 \u043A\u0456\u0440\u0456\u04A3\u0456\u0437; \u0442\u04B1\u043C\u0441\u044B\u049B\u0442\u044B \u04E9\u0437\u0456\u04A3\u0456\u0437\u0433\u0435 \u049B\u0430\u0440\u0430\u0442\u044B\u043F, 15 \u0441\u0435\u043A\u0443\u043D\u0434 \u04B1\u0441\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694557
    m_Localized: "\u0410\u043B\u0430\u04A3\u0448\u0430\u043D\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435 \u049B\u0430\u0439\u0442\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694558
    m_Localized: "\u0422\u04B1\u043C\u0441\u044B\u049B\u0442\u044B \u04E9\u0437\u0456\u04A3\u0456\u0437\u0433\u0435 \u049B\u0430\u0440\u0430\u0442\u049B\u0430\u043D \u043A\u04AF\u0439\u0456 \u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694559
    m_Localized: "\u0422\u04B1\u043C\u0441\u044B\u049B\u0442\u044B \u04E9\u0437\u0456\u043D\u0435 \u049B\u0430\u0440\u0430\u0442\u044B\u043F \u049B\u0430\u043B\u044B\u049B\u0442\u0430\u0443 \u0436\u04D9\u043D\u0435 \u049B\u043E\u043D\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694560
    m_Localized: "\u0414\u0440\u043E\u043D \u0441\u0456\u0437\u0433\u0435 \u049B\u0430\u0440\u0430\u043F \u0442\u04B1\u0440. \u0415\u043D\u0434\u0456 \u043E\u043D\u044B\u04A3 \u0441\u043E\u043B \u0436\u0430\u0493\u044B \u0441\u0456\u0437\u0434\u0456\u04A3 \u043E\u04A3 \u0436\u0430\u0493\u044B\u04A3\u044B\u0437, \u0430\u043B \u0441\u0442\u0438\u043A\u0442\u0456 \u0430\u043B\u0493\u0430 \u0438\u0442\u0435\u0440\u0441\u0435\u04A3\u0456\u0437, \u043E\u043B \u0441\u0456\u0437\u0433\u0435 \u0436\u0430\u049B\u044B\u043D\u0434\u0430\u0439\u0434\u044B. \u049A\u043E\u0440\u0430\u043F\u0442\u0430 \u049B\u0430\u043B\u044B\u049B\u0442\u0430\u043F, \u0434\u0440\u043E\u043D\u0434\u044B \u0431\u04B1\u0440\u043C\u0430\u0439 \u049B\u043E\u043D\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694561
    m_Localized: "\u0422\u04B1\u043C\u0441\u044B\u049B\u0442\u044B \u04E9\u0437\u0456\u04A3\u0456\u0437\u0433\u0435 \u049B\u0430\u0440\u0430\u0442\u044B\u043F \u04B1\u0441\u0442\u0430\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694562
    m_Localized: "\u0416\u0435\u04A3\u0456\u043B\u0434\u0435\u0442\u0443 \u04AF\u0448\u0456\u043D \u0434\u0440\u043E\u043D\u0434\u044B \u0431\u04B1\u0440\u043C\u0430\u04A3\u044B\u0437: \u0441\u0442\u0438\u043A\u0442\u0456 \u0430\u0437-\u0430\u0437\u0434\u0430\u043D \u049B\u043E\u0437\u0493\u0430\u043F, \u0434\u0440\u043E\u043D\u043D\u044B\u04A3 \u043E\u0440\u043D\u044B\u043D\u0430\u043D \u043E\u0439\u043B\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694563
    m_Localized: "1-\u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u043F, \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448\u0442\u0430\u0440\u0434\u044B \u04E9\u0448\u0456\u0440\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694564
    m_Localized: "2-\u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u043F, \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448\u0442\u0430\u0440\u0434\u044B \u04E9\u0448\u0456\u0440\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694565
    m_Localized: "3-\u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u043F, \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448\u0442\u0430\u0440\u0434\u044B \u04E9\u0448\u0456\u0440\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694566
    m_Localized: "4-\u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u043F, \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448\u0442\u0430\u0440\u0434\u044B \u04E9\u0448\u0456\u0440\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694567
    m_Localized: "\u049A\u043E\u043D\u0443 \u0430\u0439\u043D\u0430\u043B\u044B\u043C\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039168888832
    m_Localized: "\u0422\u04E9\u0440\u0442 \u0430\u043B\u0430\u04A3\u0448\u0430, \u04D9\u0440\u049B\u0430\u0439\u0441\u044B\u0441\u044B \u0430\u043B\u0434\u044B\u04A3\u0493\u044B\u0441\u044B\u043D\u0430\u043D \u043A\u0456\u0448\u0456. \u04D8\u0440\u049B\u0430\u0439\u0441\u044B\u0441\u044B\u043D\u0430 \u043A\u0435\u0437\u0435\u043A\u043F\u0435\u043D \u049B\u043E\u043D\u044B\u043F, \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448\u0442\u0430\u0440\u0434\u044B \u04E9\u0448\u0456\u0440\u0456\u04A3\u0456\u0437, \u0441\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u043A\u0435\u043B\u0435\u0441\u0456\u0441\u0456 \u04AF\u0448\u0456\u043D \u049B\u0430\u0439\u0442\u0430 \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u04A3\u0456\u0437. \u0411\u0430\u0441\u0442\u0430\u0493\u0430\u043D \u0430\u043B\u0430\u04A3\u0448\u0430\u0434\u0430 \u0430\u044F\u049B\u0442\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039168888833
    m_Localized: "\u04B0\u0448\u044B\u043F \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u043F, \u0430\u043B\u0430\u04A3\u0448\u0430 \u04AF\u0441\u0442\u0456\u043D\u0434\u0435 10 \u0441\u0435\u043A\u0443\u043D\u0434 \u049B\u0430\u043B\u044B\u049B\u0442\u0430\u04A3\u044B\u0437; \u0436\u0435\u043B\u0433\u0435 \u049B\u0430\u0440\u0441\u044B \u04B1\u0441\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039168888834
    m_Localized: "\u041E\u0440\u044B\u043D\u0434\u044B \u04B1\u0441\u0442\u0430\u0443\u0441\u044B\u0437, \u0436\u0435\u043B\u0434\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039168888835
    m_Localized: "\u041E\u0440\u044B\u043D\u0434\u044B \u04B1\u0441\u0442\u0430\u0443 \u04E9\u0448\u0456\u0440\u0456\u043B\u0433\u0435\u043D: \u0434\u0440\u043E\u043D \u0431\u0438\u0456\u043A\u0442\u0456\u0433\u0456\u043D \u0441\u0430\u049B\u0442\u0430\u0439\u0434\u044B, \u0431\u0456\u0440\u0430\u049B \u049B\u0430\u043B\u0434\u044B\u0440\u0493\u0430\u043D \u0436\u0435\u0440\u0456\u04A3\u0456\u0437\u0434\u0435 \u0442\u04B1\u0440\u043C\u0430\u0439\u0434\u044B, \u04D9\u0440\u0456 \u0436\u0435\u04A3\u0456\u043B \u0436\u0435\u043B \u043E\u043D\u044B \u0431\u04AF\u0439\u0456\u0440\u0433\u0435 \u0438\u0442\u0435\u0440\u0435\u0434\u0456. \u049A\u0430\u043B\u044B\u049B\u0442\u0430\u04A3\u044B\u0437, \u0441\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u0448\u0430\u0440\u0448\u044B\u043D\u044B \u04B1\u0448\u044B\u04A3\u044B\u0437. \u0421\u043F\u0443\u0442\u043D\u0438\u043A\u0442\u0456\u043A \u0441\u0438\u0433\u043D\u0430\u043B\u044B\u043D \u0436\u043E\u0493\u0430\u043B\u0442\u049B\u0430\u043D \u0434\u0440\u043E\u043D \u043E\u0441\u044B\u043B\u0430\u0439 \u04B1\u0448\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6775319762305024
    m_Localized: "\u0421\u043E\u043B \u0436\u0430\u049B \u0431\u0430\u0493\u0430\u043D\u0430\u043D\u044B \u0441\u0430\u0493\u0430\u0442 \u0442\u0456\u043B\u0456 \u0431\u0430\u0493\u044B\u0442\u044B\u043C\u0435\u043D \u0430\u0439\u043D\u0430\u043B\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6775319980408832
    m_Localized: "\u041E\u04A3 \u0436\u0430\u049B \u0431\u0430\u0493\u0430\u043D\u0430\u043D\u044B \u043A\u0435\u0440\u0456 \u0431\u0430\u0493\u044B\u0442\u0442\u0430 \u0430\u0439\u043D\u0430\u043B\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6775319980408833
    m_Localized: "\u0415\u043A\u0456 \u0431\u0430\u0493\u0430\u043D\u0430\u043D\u044B \u0430\u0439\u043D\u0430\u043B\u0430 \u0441\u0435\u0433\u0456\u0437\u0434\u0456\u043A \u0436\u0430\u0441\u0430\u04A3\u044B\u0437: \u0441\u043E\u043B \u0436\u0430\u049B \u0431\u0430\u0493\u0430\u043D\u0430\u043D\u044B \u0431\u0456\u0440 \u0430\u0439\u043D\u0430\u043B\u044B\u043F, \u043E\u0440\u0442\u0430\u0434\u0430\u0493\u044B \u049B\u043E\u0440\u0430\u043F \u0430\u0440\u049B\u044B\u043B\u044B \u04E9\u0442\u0456\u043F, \u043E\u04A3 \u0436\u0430\u049B \u0431\u0430\u0493\u0430\u043D\u0430\u043D\u044B \u043A\u0435\u0440\u0456 \u0431\u0430\u0493\u044B\u0442\u0442\u0430 \u0430\u0439\u043D\u0430\u043B\u044B\u04A3\u044B\u0437. \u0411\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0456 \u0431\u04AF\u043A\u0456\u043B \u0436\u043E\u043B \u0431\u043E\u0439\u044B \u0431\u0456\u0440\u0434\u0435\u0439 \u04B1\u0441\u0442\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6775319980408834
    m_Localized: "\u0421\u043E\u043B \u0436\u0430\u049B \u0431\u0430\u0493\u0430\u043D\u0430 \u0430\u0439\u043D\u0430\u043B\u0430\u0441\u044B\u043D\u0434\u0430\u0493\u044B \u0448\u0435\u04A3\u0431\u0435\u0440"
    m_Metadata:
