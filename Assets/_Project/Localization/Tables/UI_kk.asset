  - m_Id: 258319929307137
    m_Localized: "\u0410\u043B\u0442\u044B\u043D \u0441\u0430\u0493\u0430\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 258319929307138
    m_Localized: "\u0416\u0430\u0437\u0493\u044B \u043A\u04AF\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 266269578227712
    m_Localized: "\u042D\u041A\u0421\u041F\u041E \u0421\u043F\u0440\u0438\u043D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 266269620170752
    m_Localized: "\u042D\u041A\u0421\u041F\u041E \u041F\u0440\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 266269620170753
    m_Localized: "\u0411\u0430\u0441\u0442\u0430\u0443\u0448\u044B, 1,2 \u043A\u043C: \u043E\u04A3\u0442\u04AF\u0441\u0442\u0456\u043A \u0436\u0430\u044F\u0443 \u0436\u043E\u043B\u043C\u0435\u043D \u0436\u043E\u0493\u0430\u0440\u044B, \u043F\u0430\u0432\u0438\u043B\u044C\u043E\u043D \u04AF\u0441\u0442\u0456\u043D\u0435\u043D \u043E\u043D\u044B\u04A3 \u0430\u0443\u043B\u0430\u0441\u044B\u043D\u0430, \u0441\u0444\u0435\u0440\u0430\u043D\u044B 3 \u043C \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0435 \u0430\u0439\u043D\u0430\u043B\u044B\u043F, \u0441\u0430\u044F\u0431\u0430\u049B\u0442\u0430\u0493\u044B \u0441\u043B\u0430\u043B\u043E\u043C \u0436\u04D9\u043D\u0435 \u0436\u0430\u044F\u0443 \u0436\u043E\u043B\u043C\u0435\u043D \u043A\u0435\u0440\u0456. \u0416\u0430\u0442\u0442\u044B\u049B\u0442\u044B\u0440\u0443\u0448\u044B \u043D\u04B1\u0441\u049B\u0430\u0443\u044B \u04B1\u0441\u044B\u043D\u044B\u043B\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 266269620170754
    m_Localized: "\u0422\u04D9\u0436\u0456\u0440\u0438\u0431\u0435\u043B\u0456, 2,2 \u043A\u043C: \u0430\u0443\u043B\u0430\u0493\u0430 \u0441\u0435\u043A\u0456\u0440\u0443, \u0441\u0444\u0435\u0440\u0430\u043D\u044B 90 \u043C-\u0433\u0435 \u0434\u0435\u0439\u0456\u043D \u0441\u043F\u0438\u0440\u0430\u043B\u044C\u043C\u0435\u043D \u0430\u0439\u043D\u0430\u043B\u0443, \u0441\u0430\u044F\u0431\u0430\u049B\u049B\u0430 \u049B\u04B1\u043B\u0434\u0438\u043B\u0430\u0443, \u0430\u0439\u043D\u0430\u043B\u043C\u0430 \u0436\u043E\u043B\u0434\u0430\u0493\u044B \u0436\u044B\u043B\u0434\u0430\u043C \u0431\u04B1\u0440\u044B\u043B\u044B\u0441\u0442\u0430\u0440 \u0436\u04D9\u043D\u0435 \u0435\u043A\u0456\u043D\u0448\u0456 \u0430\u0443\u043B\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 274119067168768
