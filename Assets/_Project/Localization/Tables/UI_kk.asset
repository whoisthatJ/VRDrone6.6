      m_Items: []
  - m_Id: 6771039164694542
    m_Localized: "\u0411\u0430\u0493\u0430\u043D\u0430\u0434\u0430\u043D 5 \u043C \u049B\u0430\u0448\u044B\u049B\u0442\u044B\u049B\u0442\u0430 \u043E\u043D\u044B \u0430\u0439\u043D\u0430\u043B\u0430 \u04B1\u0448\u044B\u04A3\u044B\u0437, \u0434\u0440\u043E\u043D\u043D\u044B\u04A3 \u0442\u04B1\u043C\u0441\u044B\u0493\u044B \u0431\u04AF\u043A\u0456\u043B \u0436\u043E\u043B \u0431\u043E\u0439\u044B \u0431\u0430\u0493\u0430\u043D\u0430\u0493\u0430 \u049B\u0430\u0440\u0430\u043F \u0442\u04B1\u0440\u0441\u044B\u043D. \u0421\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u043A\u0435\u0440\u0456 \u0431\u0430\u0493\u044B\u0442\u0442\u0430 \u049B\u0430\u0439\u0442\u0430\u043B\u0430\u04A3\u044B\u0437. \u0415\u043A\u0456 \u0441\u0442\u0438\u043A \u0431\u0456\u0440 \u043C\u0435\u0437\u0433\u0456\u043B\u0434\u0435 \u043A\u0435\u0440\u0435\u043A: \u0431\u0456\u0440\u0456 \u0434\u0440\u043E\u043D\u0434\u044B \u0431\u04AF\u0439\u0456\u0440\u0433\u0435 \u0436\u044B\u043B\u0436\u044B\u0442\u0430\u0434\u044B, \u0435\u043A\u0456\u043D\u0448\u0456\u0441\u0456 \u0431\u04B1\u0440\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694543
    m_Localized: "\u0411\u0430\u0493\u0430\u043D\u0430\u0434\u0430\u043D \u049B\u0430\u0448\u044B\u049B\u0442\u044B\u049B\u0442\u044B \u0441\u0430\u049B\u0442\u0430\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694544
    m_Localized: "\u0428\u0435\u04A3\u0431\u0435\u0440 \u04AF\u043B\u043A\u0435\u0439\u0441\u0435, \u0431\u0430\u0493\u0430\u043D\u0430\u0493\u0430 \u0441\u04D9\u043B \u0436\u0430\u049B\u044B\u043D\u0434\u0430\u04A3\u044B\u0437; \u043A\u0456\u0448\u0456\u0440\u0435\u0439\u0441\u0435, \u0430\u043B\u044B\u0441\u0442\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694545
    m_Localized: "\u0422\u04B1\u043C\u0441\u044B\u049B \u0431\u0430\u0493\u0430\u043D\u0430\u0493\u0430 \u049B\u0430\u0440\u0430\u0493\u0430\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694546
    m_Localized: "\u041E\u04A3 \u0441\u0442\u0438\u043A\u043F\u0435\u043D \u0436\u044B\u043B\u0436\u044B\u0493\u0430\u043D \u049B\u0430\u0440\u049B\u044B\u043D\u043C\u0435\u043D \u0441\u043E\u043B \u0441\u0442\u0438\u043A\u043F\u0435\u043D \u0431\u04B1\u0440\u044B\u043B\u044B\u04A3\u044B\u0437."
    m_Metadata:
