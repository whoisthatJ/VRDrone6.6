    m_Localized: "\u0416\u0430\u0440\u0442\u044B \u0431\u04E9\u0448\u043A\u0435: \u0434\u0440\u043E\u043D\u0434\u044B \u0430\u0440\u049B\u0430\u0441\u044B\u043D\u0430 \u0430\u0443\u0434\u0430\u0440\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220418
    m_Localized: "\u0414\u0440\u043E\u043D \u049B\u0430\u0439\u0442\u0430 \u0442\u04AF\u0437\u0435\u043B\u0433\u0435\u043D\u0448\u0435 \u043E\u04A3 \u0441\u0442\u0438\u043A\u0442\u0456 \u04E9\u0437\u0456\u04A3\u0456\u0437\u0433\u0435 \u0442\u0430\u0440\u0442\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220419
    m_Localized: "\u041A\u0435\u043B\u0433\u0435\u043D \u0436\u0430\u0493\u044B\u04A3\u044B\u0437\u0493\u0430 \u049B\u0430\u0440\u0430\u0439 \u0442\u04AF\u0437\u0443 \u04B1\u0448\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220420
    m_Localized: "\u0421\u043F\u043B\u0438\u0442-S"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220421
    m_Localized: "\u0421\u043F\u043B\u0438\u0442-S \u0434\u0440\u043E\u043D\u0434\u044B \u043A\u0435\u0440\u0456 \u0431\u04B1\u0440\u044B\u043F, \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0456 \u0436\u044B\u043B\u0434\u0430\u043C\u0434\u044B\u049B\u049B\u0430 \u0430\u0439\u044B\u0440\u0431\u0430\u0441\u0442\u0430\u0439\u0434\u044B. 20 \u043C-\u0433\u0435 \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u043F, \u0430\u043B\u0493\u0430 \u04B1\u0448\u044B\u04A3\u044B\u0437. \u0410\u0440\u049B\u0430\u04A3\u044B\u0437\u0493\u0430 \u0430\u0443\u0434\u0430\u0440\u044B\u043B\u044B\u043F, \u0433\u0430\u0437\u0434\u044B \u0430\u0437\u0430\u0439\u0442\u044B\u04A3\u044B\u0437, \u0441\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u043E\u04A3 \u0441\u0442\u0438\u043A\u0442\u0456 \u04E9\u0437\u0456\u04A3\u0456\u0437\u0433\u0435 \u0442\u0430\u0440\u0442\u044B\u04A3\u044B\u0437: \u0442\u04B1\u043C\u0441\u044B\u049B \u0442\u0456\u043A \u0442\u04E9\u043C\u0435\u043D \u0430\u0440\u049B\u044B\u043B\u044B \u04E9\u0442\u0456\u043F, \u043A\u0435\u043B\u0433\u0435\u043D \u0436\u0430\u0493\u044B\u04A3\u044B\u0437\u0493\u0430 \u049B\u0430\u0440\u0430\u043F \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0435\u0434\u0456. \u0411\u04B1\u043B \u049B\u0438\u043C\u044B\u043B \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0456 \u0430\u043B\u0430\u0434\u044B, \u0441\u043E\u043D\u0434\u044B\u049B\u0442\u0430\u043D \u043E\u043D\u044B \u0435\u0448\u049B\u0430\u0448\u0430\u043D \u0442\u04E9\u043C\u0435\u043D\u043D\u0435\u043D \u0431\u0430\u0441\u0442\u0430\u043C\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220422
    m_Localized: "\u049A\u0430\u049B\u043F\u0430\u0434\u0430\u043D \u0436\u0430\u049B\u0441\u044B \u0436\u044B\u043B\u0434\u0430\u043C\u0434\u044B\u049B\u043F\u0435\u043D \u04B1\u0448\u044B\u043F \u04E9\u0442\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220423
    m_Localized: "\u0413\u0430\u0437\u0434\u044B \u049B\u043E\u0441\u044B\u043F, \u0442\u04B1\u043C\u0441\u044B\u049B \u0430\u0441\u043F\u0430\u043D\u0493\u0430 \u049B\u0430\u0440\u0430\u0493\u0430\u043D\u0448\u0430 \u0441\u0442\u0438\u043A\u0442\u0456 \u0442\u0430\u0440\u0442\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220424
    m_Localized: "\u049A\u0430\u049B\u043F\u0430\u043D\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435\u043D \u0430\u0441\u044B\u043F \u04E9\u0442\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220425
    m_Localized: "\u0413\u0430\u0437\u0434\u044B \u0430\u0437\u0430\u0439\u0442\u044B\u043F, \u0434\u0440\u043E\u043D \u049B\u0430\u0439\u0442\u0430 \u0442\u04AF\u0437\u0435\u043B\u0433\u0435\u043D\u0448\u0435 \u0442\u0430\u0440\u0442\u0443\u0434\u044B \u0436\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220426
    m_Localized: "\u0421\u043E\u043B \u049B\u0430\u049B\u043F\u0430\u0434\u0430\u043D \u049B\u0430\u0439\u0442\u0430 \u04E9\u0442\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220427
    m_Localized: "\u041A\u04AF\u0448 \u0442\u04B1\u0437\u0430\u0493\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220428
    m_Localized: "\u041A\u04AF\u0448 \u0442\u04B1\u0437\u0430\u0493\u044B\u043D\u0434\u0430 \u0434\u0440\u043E\u043D \u049B\u0430\u049B\u043F\u0430\u0434\u0430\u043D \u04E9\u0442\u0456\u043F, \u043E\u043D\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435\u043D \u0430\u0440\u049B\u0430\u0441\u044B\u043C\u0435\u043D \u0430\u0441\u044B\u043F, \u049B\u0430\u0439\u0442\u0430\u0434\u0430\u043D \u049B\u0430\u049B\u043F\u0430\u0434\u0430\u043D \u0442\u04E9\u043C\u0435\u043D \u04E9\u0442\u0435\u0434\u0456. \u0416\u044B\u043B\u0434\u0430\u043C \u04E9\u0442\u0456\u043F, \u0433\u0430\u0437\u0434\u044B \u049B\u043E\u0441\u044B\u043F, \u0441\u0442\u0438\u043A\u0442\u0456 \u0442\u0430\u0440\u0442\u044B\u04A3\u044B\u0437. \u0416\u043E\u0493\u0430\u0440\u0493\u044B \u043D\u04AF\u043A\u0442\u0435\u0434\u0435 \u0433\u0430\u0437\u0434\u044B \u0430\u0437\u0430\u0439\u0442\u044B\u043F, \u0442\u0430\u0440\u0442\u0443\u0434\u044B \u0436\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u044B\u04A3\u044B\u0437 \u0434\u0430, \u0442\u04B1\u043C\u0441\u044B\u049B \u0442\u04E9\u043C\u0435\u043D\u0434\u0435\u0433\u0435\u043D\u0434\u0435 \u049B\u0430\u049B\u043F\u0430\u043D\u044B \u0456\u0437\u0434\u0435\u04A3\u0456\u0437. \u041A\u0435\u04A3 \u0442\u04B1\u0437\u0430\u049B \u0442\u0430\u0440 \u0442\u04B1\u0437\u0430\u049B\u0442\u0430\u043D \u043E\u04A3\u0430\u0439\u044B\u0440\u0430\u049B."
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220429
    m_Localized: "12 \u043C \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u043A\u0435 \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220430
    m_Localized: "\u0411\u04E9\u0448\u043A\u0435: \u0434\u0440\u043E\u043D \u0442\u043E\u043B\u044B\u049B \u0430\u0439\u043D\u0430\u043B\u0493\u0430\u043D\u0448\u0430 \u043E\u04A3 \u0441\u0442\u0438\u043A\u0442\u0456 \u0431\u0456\u0440 \u0436\u0430\u049B\u049B\u0430 \u0442\u043E\u043B\u044B\u049B \u0438\u0442\u0435\u0440\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220431
    m_Localized: "\u0422\u04AF\u0437\u0435\u043B\u0456\u043F, \u049B\u0430\u0439\u0442\u0430\u0434\u0430\u043D 12 \u043C-\u0433\u0435 \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220432
    m_Localized: "\u0421\u0430\u043B\u044C\u0442\u043E: \u0434\u0440\u043E\u043D \u0442\u043E\u043B\u044B\u049B \u0430\u0439\u043D\u0430\u043B\u0493\u0430\u043D\u0448\u0430 \u043E\u04A3 \u0441\u0442\u0438\u043A\u0442\u0456 \u0430\u043B\u0493\u0430 \u043D\u0435\u043C\u0435\u0441\u0435 \u0430\u0440\u0442\u049B\u0430 \u0442\u043E\u043B\u044B\u049B \u0438\u0442\u0435\u0440\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220433
    m_Localized: "\u0411\u04E9\u0448\u043A\u0435 \u0436\u04D9\u043D\u0435 \u0441\u0430\u043B\u044C\u0442\u043E"
    m_Metadata:
      m_Items: []
  - m_Id: 6924680492220434
    m_Localized: "\u0424\u0440\u0438\u0441\u0442\u0430\u0439\u043B\u0434\u044B\u04A3 \u0431\u0430\u0440\u043B\u044B\u049B \u0442\u0440\u044E\u043A\u0442\u0435\u0440\u0456 \u043E\u0441\u044B \u0435\u043A\u0456 \u049B\u0438\u043C\u044B\u043B\u0434\u0430\u043D \u049B\u04B1\u0440\u0430\u043B\u0430\u0434\u044B. 12 \u043C-\u0433\u0435 \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u04A3\u0456\u0437. \u04D8\u0440 \u049B\u0438\u043C\u044B\u043B \u04AF\u0448\u0456\u043D: \u0433\u0430\u0437\u0434\u044B \u049B\u044B\u0441\u049B\u0430 \u0443\u0430\u049B\u044B\u0442\u049B\u0430 \u049B\u043E\u0441\u044B\u04A3\u044B\u0437, \u0441\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u0430\u0437\u0430\u0439\u0442\u044B\u04A3\u044B\u0437, \u043E\u04A3 \u0441\u0442\u0438\u043A\u0442\u0456 \u0442\u043E\u043B\u044B\u049B \u0438\u0442\u0435\u0440\u0456\u043F, \u043A\u04E9\u043A\u0436\u0438\u0435\u043A \u049B\u0430\u0439\u0442\u0430 \u043E\u0440\u0430\u043B\u0493\u0430\u043D\u0448\u0430 \u04B1\u0441\u0442\u0430\u04A3\u044B\u0437, \u0441\u043E\u0434\u0430\u043D \u0441\u043E\u04A3 \u0441\u0442\u0438\u043A\u0442\u0456 \u043E\u0440\u0442\u0430\u0493\u0430 \u049B\u043E\u0439\u044B\u043F, \u0434\u0440\u043E\u043D\u0434\u044B \u0433\u0430\u0437\u0431\u0435\u043D \u04B1\u0441\u0442\u0430\u043F \u0430\u043B\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6926043406139392
    m_Localized: "\u0421\u0415\u0420\u0422\u0418\u0424\u0418\u041A\u0410\u0422"
    m_Metadata:
      m_Items: []
