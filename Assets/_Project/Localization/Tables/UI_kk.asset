  - m_Id: 6926043414528011
    m_Localized: "\u04B0\u0448\u0443\u043B\u0430\u0440 Ushqyr \u0441\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B\u043D\u0434\u0430 \u043E\u0440\u044B\u043D\u0434\u0430\u043B\u0434\u044B. \u0411\u04B1\u043B \u0441\u0435\u0440\u0442\u0438\u0444\u0438\u043A\u0430\u0442 \u043E\u049B\u0443\u0434\u0430\u043D \u04E9\u0442\u043A\u0435\u043D\u0456\u043D \u0440\u0430\u0441\u0442\u0430\u0439\u0434\u044B; \u043E\u043B \u0434\u0440\u043E\u043D\u0434\u044B \u04B1\u0448\u044B\u0440\u0443\u0493\u0430 \u0440\u04B1\u049B\u0441\u0430\u0442 \u0435\u043C\u0435\u0441."
