  - m_Id: 6778737700634655
    m_Localized: "3-\u0448\u0435\u043B\u0435\u043A\u0442\u0456\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435 \u04B1\u0448\u044B\u043F, \u0442\u0456\u043A \u0442\u04E9\u043C\u0435\u043D \u049B\u0430\u0440\u0430\u043F, \u0441\u0443\u0440\u0435\u0442\u043A\u0435 \u0442\u04AF\u0441\u0456\u0440\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634656
    m_Localized: "\u0411\u0430\u0440\u043B\u0430\u0443: \u04AF\u0448 \u0448\u0435\u043B\u0435\u043A\u0442\u0456\u04A3 \u0456\u0448\u0456\u043D\u0435 \u049B\u0430\u0440\u0430\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634657
    m_Localized: "\u04AE\u0448 \u0448\u0435\u043B\u0435\u043A \u0436\u0435\u0440\u0434\u0435 \u0430\u0443\u0437\u044B \u0436\u043E\u0493\u0430\u0440\u044B \u049B\u0430\u0440\u0430\u043F \u0436\u0430\u0442\u044B\u0440. \u04D8\u0440\u049B\u0430\u0439\u0441\u044B\u0441\u044B\u043D\u044B\u04A3 \u04AF\u0441\u0442\u0456\u043D\u0435\u043D 3 \u043C \u043D\u0435\u043C\u0435\u0441\u0435 \u043E\u0434\u0430\u043D \u0431\u0438\u0456\u043A \u04B1\u0448\u044B\u043F, \u043A\u0430\u043C\u0435\u0440\u0430\u043D\u044B \u0442\u0456\u043A \u0442\u04E9\u043C\u0435\u043D \u0435\u04A3\u043A\u0435\u0439\u0442\u0456\u04A3\u0456\u0437, \u0448\u0435\u043B\u0435\u043A\u0442\u0456 \u0441\u0443\u0440\u0435\u0442\u0442\u0456\u04A3 \u043E\u0440\u0442\u0430\u0441\u044B\u043D\u0430 \u043A\u0435\u043B\u0442\u0456\u0440\u0456\u043F, \u0441\u0443\u0440\u0435\u0442\u043A\u0435 \u0442\u04AF\u0441\u0456\u0440\u0456\u04A3\u0456\u0437. \u049A\u0430\u0436\u0435\u0442 \u0431\u043E\u043B\u0441\u0430, \u04AF\u043B\u043A\u0435\u0439\u0442\u0456\u04A3\u0456\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634658
    m_Localized: "\u0410\u043B\u044B\u0441 \u049B\u043E\u0440\u0430\u043F\u049B\u0430 \u04B1\u0448\u044B\u043F, \u043E\u043D\u044B 3 \u0441\u0435\u043A\u0443\u043D\u0434 \u04B1\u0441\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634659
    m_Localized: "\u0411\u0430\u0442\u0430\u0440\u0435\u044F \u0442\u0430\u0443\u0441\u044B\u043B\u044B\u043F \u0431\u0430\u0440\u0430\u0434\u044B: \u0442\u0443\u0440\u0430 \u043A\u0435\u0440\u0456 \u04B1\u0448\u044B\u043F, \u0430\u043B\u0430\u04A3\u0448\u0430 \u04AF\u0441\u0442\u0456\u043D\u0434\u0435 \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634660
    m_Localized: "\u0411\u0456\u0440 \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448 \u04D9\u043B\u0441\u0456\u0440\u0435\u0434\u0456: \u049B\u0430\u0437\u0456\u0440 \u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u0436\u0430\u0439\u043B\u0430\u043F \u049B\u043E\u043D\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634661
    m_Localized: "\u0422\u04E9\u0442\u0435\u043D\u0448\u0435 \u0436\u0430\u0493\u0434\u0430\u0439 \u0436\u0430\u0442\u0442\u044B\u0493\u0443\u043B\u0430\u0440\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634662
    m_Localized: "\u0411\u04B1\u043B \u04B1\u0448\u0443\u0434\u0430 \u0430\u049B\u0430\u0443\u043B\u0430\u0440 \u0431\u043E\u043B\u0430\u0434\u044B. \u0410\u043B\u044B\u0441 \u049B\u043E\u0440\u0430\u043F\u049B\u0430 \u0436\u0435\u0442\u043A\u0435\u043D\u0434\u0435 \u0431\u0430\u0442\u0430\u0440\u0435\u044F \u043A\u04AF\u0440\u0442 \u0430\u0437\u0430\u044F\u0434\u044B: \u0431\u0456\u0440\u0434\u0435\u043D \u043A\u0435\u0440\u0456 \u049B\u0430\u0439\u0442\u044B\u04A3\u044B\u0437. \u0410\u043B\u0430\u04A3\u0448\u0430 \u04AF\u0441\u0442\u0456\u043D\u0434\u0435 \u0431\u0456\u0440 \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448 \u04D9\u043B\u0441\u0456\u0440\u0435\u0439\u0434\u0456: \u0434\u0435\u0440\u0435\u0443 \u04D9\u0440\u0456 \u0436\u0430\u0439\u043B\u0430\u043F \u049B\u043E\u043D\u044B\u04A3\u044B\u0437. \u042D\u043A\u0440\u0430\u043D\u043D\u044B\u04A3 \u0436\u043E\u0493\u0430\u0440\u0493\u044B \u0436\u0430\u0493\u044B\u043D \u043E\u049B\u044B\u043F, \u049B\u0430\u0436\u0435\u0442\u0442\u0435\u043D \u0430\u0440\u0442\u044B\u049B \u0430\u0441\u044B\u049B\u043F\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6778737700634663
    m_Localized: "\u049A\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448 \u04D9\u043B\u0441\u0456\u0437 \u0431\u043E\u043B\u0493\u0430\u043D\u0434\u0430 \u0434\u0440\u043E\u043D \u0442\u0435\u0437\u0456\u0440\u0435\u043A \u0442\u04E9\u043C\u0435\u043D\u0434\u0435\u0439\u0434\u0456: \u0433\u0430\u0437\u0434\u044B \u04D9\u0434\u0435\u0442\u0442\u0435\u0433\u0456\u0434\u0435\u043D \u0435\u0440\u0442\u0435\u0440\u0435\u043A \u049B\u043E\u0441\u044B\u04A3\u044B\u0437."
