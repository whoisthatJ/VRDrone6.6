    m_Localized: "\u0422\u0456\u0440\u0435\u043A\u0442\u0435 \u0442\u04E9\u0440\u0442 \u0448\u0435\u043B\u0435\u043A \u0431\u0430\u0440, \u04D9\u0440\u049B\u0430\u0439\u0441\u044B\u0441\u044B \u0431\u0456\u0440 \u0436\u0430\u049B\u049B\u0430 \u049B\u0430\u0440\u0430\u043F \u0442\u04B1\u0440. \u041A\u0430\u043C\u0435\u0440\u0430\u043D\u044B \u0442\u0456\u0440\u0435\u043A\u043A\u0435 \u049B\u0430\u0440\u0430\u0442\u044B\u043F, \u043E\u043D\u044B 5 \u043C \u049B\u0430\u0448\u044B\u049B\u0442\u044B\u049B\u0442\u0430 \u0441\u0430\u0493\u0430\u0442 \u0442\u0456\u043B\u0456 \u0431\u0430\u0493\u044B\u0442\u044B\u043C\u0435\u043D \u0430\u0439\u043D\u0430\u043B\u044B\u04A3\u044B\u0437 \u0434\u0430, \u04D9\u0440 \u0448\u0435\u043B\u0435\u043A\u0442\u0456\u04A3 \u0430\u043B\u0434\u044B\u043D\u0430 \u043A\u0435\u043B\u0433\u0435\u043D\u0434\u0435 \u0441\u0443\u0440\u0435\u0442\u043A\u0435 \u0442\u04AF\u0441\u0456\u0440\u0456\u04A3\u0456\u0437."
