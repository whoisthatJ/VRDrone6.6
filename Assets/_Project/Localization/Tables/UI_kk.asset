    m_Localized: "\u041E\u0440\u043D\u044B\u043D\u0434\u0430 \u0442\u04B1\u0440\u044B\u043F, \u043E\u04A3\u0493\u0430 \u0442\u043E\u043B\u044B\u049B \u0430\u0439\u043D\u0430\u043B\u044B\u043C \u0436\u0430\u0441\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061776
    m_Localized: "\u041E\u0440\u043D\u044B\u043D\u0434\u0430 \u0442\u04B1\u0440\u044B\u043F, \u0441\u043E\u043B\u0493\u0430 \u0442\u043E\u043B\u044B\u049B \u0430\u0439\u043D\u0430\u043B\u044B\u043C \u0436\u0430\u0441\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061777
    m_Localized: "\u041F\u0438\u0440\u0443\u044D\u0442"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061778
    m_Localized: "\u0428\u0430\u0493\u044B\u043D \u049B\u043E\u0440\u0430\u043F\u0442\u0430 \u049B\u0430\u043B\u044B\u049B\u0442\u0430\u043F \u0442\u04B1\u0440\u044B\u043F, \u0434\u0440\u043E\u043D\u0434\u044B \u0431\u0456\u0440 \u0440\u0435\u0442 \u043E\u04A3\u0493\u0430, \u0441\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u0431\u0456\u0440 \u0440\u0435\u0442 \u0441\u043E\u043B\u0493\u0430 \u0430\u0439\u043D\u0430\u043B\u0434\u044B\u0440\u044B\u04A3\u044B\u0437, \u049B\u043E\u0440\u0430\u043F\u0442\u0430\u043D \u0448\u044B\u049B\u043F\u0430\u04A3\u044B\u0437. \u0414\u0440\u043E\u043D\u0434\u044B \u0442\u0435\u043A \u0441\u043E\u043B \u0441\u0442\u0438\u043A \u0431\u04B1\u0440\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061779
    m_Localized: "\u0411\u04B1\u0440\u044B\u043B\u0443 \u043A\u0435\u0437\u0456\u043D\u0434\u0435 \u049B\u043E\u0440\u0430\u043F\u0442\u0430 \u049B\u0430\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061780
    m_Localized: "\u0411\u0430\u044F\u0443 \u0431\u04B1\u0440\u044B\u043B\u044B\u04A3\u044B\u0437. \u0414\u0440\u043E\u043D \u044B\u0493\u044B\u0441\u044B\u043F \u043A\u0435\u0442\u0441\u0435, \u0431\u04B1\u0440\u044B\u043B\u0443\u0434\u044B \u0442\u043E\u049B\u0442\u0430\u0442\u044B\u043F, \u043E\u043D\u044B \u049B\u0430\u0439\u0442\u0430\u0440\u044B\u04A3\u044B\u0437 \u0434\u0430, \u0436\u0430\u043B\u0493\u0430\u0441\u0442\u044B\u0440\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061781
    m_Localized: "\u04B0\u0448\u044B\u043F \u043A\u04E9\u0442\u0435\u0440\u0456\u043B\u0456\u043F, 2 \u043C \u0431\u0438\u0456\u043A\u0442\u0456\u043A\u0442\u0435\u0433\u0456 \u0436\u0430\u049B\u044B\u043D \u049B\u043E\u0440\u0430\u043F\u0442\u0430 \u049B\u0430\u043B\u044B\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061782
    m_Localized: "15 \u043C \u0430\u043B\u0493\u0430 \u04B1\u0448\u044B\u043F, \u0430\u043B\u044B\u0441 \u049B\u043E\u0440\u0430\u043F\u0442\u0430 3 \u0441\u0435\u043A\u0443\u043D\u0434 \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061783
    m_Localized: "\u041A\u0435\u0440\u0456 \u04B1\u0448\u044B\u043F, \u0436\u0430\u049B\u044B\u043D \u049B\u043E\u0440\u0430\u043F\u0442\u0430 3 \u0441\u0435\u043A\u0443\u043D\u0434 \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061784
    m_Localized: "\u0411\u0430\u0440\u044B\u043F \u049B\u0430\u0439\u0442\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061785
    m_Localized: "15 \u043C \u049B\u0430\u0448\u044B\u049B\u0442\u044B\u049B\u0442\u0430\u0493\u044B \u0430\u043B\u044B\u0441 \u049B\u043E\u0440\u0430\u043F\u049B\u0430 \u0442\u0443\u0440\u0430 \u0430\u043B\u0493\u0430 \u04B1\u0448\u044B\u043F, \u043E\u043D\u044B\u04A3 \u0456\u0448\u0456\u043D\u0434\u0435 \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437. \u0421\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u043A\u0435\u0440\u0456 \u04B1\u0448\u044B\u043F, \u0436\u0430\u049B\u044B\u043D \u049B\u043E\u0440\u0430\u043F\u0442\u0430 \u0442\u043E\u049B\u0442\u0430\u043F, \u049B\u043E\u043D\u044B\u04A3\u044B\u0437. \u049A\u043E\u0440\u0430\u043F\u049B\u0430 \u0436\u0435\u0442\u043F\u0435\u0439 \u0442\u04B1\u0440\u044B\u043F \u0431\u0430\u044F\u0443\u043B\u0430\u0439 \u0431\u0430\u0441\u0442\u0430\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061786
    m_Localized: "\u0422\u04AF\u0437\u0443 \u0441\u044B\u0437\u044B\u049B\u043F\u0435\u043D \u04B1\u0448\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061787
    m_Localized: "\u041E\u04A3 \u0441\u0442\u0438\u043A\u0442\u0456 \u049B\u0438\u0493\u0430\u0448 \u0435\u043C\u0435\u0441, \u0442\u0443\u0440\u0430 \u0436\u043E\u0493\u0430\u0440\u044B-\u0442\u04E9\u043C\u0435\u043D \u0438\u0442\u0435\u0440\u0456\u04A3\u0456\u0437."
