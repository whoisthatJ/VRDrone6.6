    m_Localized: "\u0411\u0430\u0493\u0430\u043D\u0430\u043B\u0430\u0440 \u0430\u0440\u0430\u0441\u044B\u043D\u0434\u0430\u0493\u044B \u049B\u043E\u0440\u0430\u043F \u0430\u0440\u049B\u044B\u043B\u044B \u04E9\u0442\u0456\u04A3\u0456\u0437"
    m_Metadata:
