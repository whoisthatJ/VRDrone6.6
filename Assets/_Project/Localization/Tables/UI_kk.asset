    m_Metadata:
      m_Items: []
  - m_Id: 2872970309684
    m_Localized: "650 \u0433, \u0442\u0430\u0440\u0442\u0443/\u0441\u0430\u043B\u043C\u0430\u049B ~10:1. \u0416\u0435\u04A3\u0456\u043B, \u0436\u044B\u043B\u0434\u0430\u043C \u0436\u04D9\u043D\u0435 \u0441\u0435\u0437\u0456\u043C\u0442\u0430\u043B: \u0436\u0430\u0440\u044B\u0441 \u043A\u043B\u0430\u0441\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309685
    m_Localized: "\u042D\u043A\u0448\u043D-\u043A\u0430\u043C\u0435\u0440\u0430\u043C\u0435\u043D 750 \u0433, ~7.5:1. \u0418\u043D\u0435\u0440\u0446\u0438\u044F\u0441\u044B \u043A\u04E9\u0431\u0456\u0440\u0435\u043A, \u0436\u04B1\u043C\u0441\u0430\u0493\u044B\u0440\u0430\u049B, Actual \u0440\u0435\u0439\u0442\u0442\u0435\u0440."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309686
    m_Localized: "32 \u0433 \u049B\u043E\u0440\u0493\u0430\u043D\u044B\u0441 \u0441\u0430\u049B\u0438\u043D\u0430\u043B\u044B \u043A\u0456\u0448\u043A\u0435\u043D\u0442\u0430\u0439 \u0432\u0443\u043F, ~3:1. \u0411\u0430\u044F\u0443, \u0436\u0435\u04A3\u0456\u043B \u0436\u04D9\u043D\u0435 \u043A\u0435\u0448\u0456\u0440\u0456\u043C\u0434\u0456: \u0431\u04E9\u043B\u043C\u0435\u0434\u0435 \u0436\u04D9\u043D\u0435 \u04AF\u0439\u0440\u0435\u043D\u0443\u0433\u0435 \u0442\u0430\u043C\u0430\u0448\u0430."
