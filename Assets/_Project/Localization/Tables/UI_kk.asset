  - m_Id: 2872970309721
    m_Localized: "\u0420\u044B\u0441\u043A\u0430\u043D\u0438\u0435\u043D\u0456 \u043E\u0440\u0442\u0430\u0493\u0430 \u049B\u0430\u0439\u0442\u0430\u0440\u044B\u04A3\u044B\u0437. \u0422\u0410\u041D\u0413\u0410\u0416\u0414\u042B \u0442\u043E\u043B\u044B\u049B \u0410\u041B\u0492\u0410 (\u0442\u04B1\u043C\u0441\u044B\u0493\u044B \u0442\u04E9\u043C\u0435\u043D) \u0438\u0442\u0435\u0440\u0456\u043F, \u04B1\u0441\u0442\u0430\u043F \u0442\u04B1\u0440\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309722
    m_Localized: "\u0422\u0430\u043D\u0433\u0430\u0436\u0434\u044B \u043E\u0440\u0442\u0430\u0493\u0430 \u049B\u0430\u0439\u0442\u0430\u0440\u044B\u04A3\u044B\u0437. \u041A\u0420\u0415\u041D\u0414\u0406 \u0442\u043E\u043B\u044B\u049B \u041E\u04A2\u0492\u0410 \u0438\u0442\u0435\u0440\u0456\u043F, \u04B1\u0441\u0442\u0430\u043F \u0442\u04B1\u0440\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309723
    m_Localized: "\u0421\u0442\u0438\u043A\u0442\u0435\u0440\u0434\u0456 \u043E\u0440\u0442\u0430\u0493\u0430 \u049B\u0430\u0439\u0442\u0430\u0440\u044B\u04A3\u044B\u0437. ARM \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0493\u044B\u0448\u044B\u043D ARMED \u043A\u04AF\u0439\u0456\u043D\u0435 \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u044B\u043F, \u04B1\u0441\u0442\u0430\u043F \u0442\u04B1\u0440\u044B\u04A3\u044B\u0437.\n(\u0413\u0430\u0437 \u0442\u04E9\u043C\u0435\u043D \u043A\u0435\u0437\u0434\u0435 \u0456\u0441\u043A\u0435 \u049B\u043E\u0441\u049B\u044B\u04A3\u044B\u0437 \u043A\u0435\u043B\u0441\u0435, \u04E9\u0442\u043A\u0456\u0437\u0456\u043F \u0436\u0456\u0431\u0435\u0440\u0456\u04A3\u0456\u0437.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309724
    m_Localized: "MODE \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0493\u044B\u0448\u044B\u043D ACRO \u043A\u04AF\u0439\u0456\u043D\u0435 \u049B\u043E\u0439\u044B\u043F, \u0441\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D ANGLE \u043A\u04AF\u0439\u0456\u043D\u0435 \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u044B\u043F, \u04B1\u0441\u0442\u0430\u043F \u0442\u04B1\u0440\u044B\u04A3\u044B\u0437.\n(\u0420\u0435\u0436\u0438\u043C \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0493\u044B\u0448\u044B\u043D \u049B\u043E\u043B\u0434\u0430\u043D\u0431\u0430\u0441\u0430\u04A3\u044B\u0437, \u04E9\u0442\u043A\u0456\u0437\u0456\u043F \u0436\u0456\u0431\u0435\u0440\u0456\u04A3\u0456\u0437.)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309725
    m_Localized: "\u0420\u0435\u0436\u0438\u043C \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u0493\u044B\u0448\u044B\u043D\u0434\u0430 \u04AF\u0448\u0456\u043D\u0448\u0456 \u043A\u04AF\u0439 \u0431\u043E\u043B\u0441\u0430, \u043E\u043D\u044B HORIZON \u043A\u04AF\u0439\u0456\u043D\u0435 \u0430\u0443\u044B\u0441\u0442\u044B\u0440\u044B\u043F, \u04B1\u0441\u0442\u0430\u043F \u0442\u04B1\u0440\u044B\u04A3\u044B\u0437.\n(\u0411\u0456\u0440\u043D\u0435\u0448\u0435 \u0441\u0435\u043A\u0443\u043D\u0434\u0442\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u04E9\u0437\u0434\u0456\u0433\u0456\u043D\u0435\u043D \u04E9\u0442\u0435\u0434\u0456.)"
