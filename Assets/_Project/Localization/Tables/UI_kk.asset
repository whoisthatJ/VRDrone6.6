    m_Metadata:
      m_Items: []
  - m_Id: 2872970309651
    m_Localized: "\u0416\u0430\u0442\u0442\u044B\u049B\u0442\u044B\u0440\u0443\u0448\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309652
    m_Localized: "\u0415\u043B\u0435\u0441 \u0436\u043E\u043B\u0430\u049B\u0442\u0430\u0440"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309653
    m_Localized: "\u0416\u0430\u0442\u0442\u044B\u049B\u0442\u044B\u0440\u0443\u0448\u044B \u0436\u0430\u0440\u044B\u0441 \u0441\u044B\u0437\u044B\u0493\u044B\u043D (\u0436\u0430\u0441\u044B\u043B: \u0436\u044B\u043B\u0434\u0430\u043C, \u0441\u0430\u0440\u044B: \u0442\u0435\u0436\u0435\u0443, \u049B\u044B\u0437\u044B\u043B: \u0431\u0430\u044F\u0443) \u0436\u04D9\u043D\u0435 \u043A\u0435\u043B\u0435\u0441\u0456 \u049B\u0430\u049B\u043F\u0430\u0493\u0430 \u043A\u04E9\u0440\u0441\u0435\u0442\u043A\u0456\u0448 \u049B\u043E\u0441\u0430\u0434\u044B. \u0415\u043B\u0435\u0441 \u0436\u043E\u043B\u0430\u049B\u0442\u0430\u0440: \u0436\u043E\u043B\u0430\u049B \u0431\u0430\u0493\u0430\u043D\u0434\u0430\u0440\u044B \u0430\u0440\u049B\u044B\u043B\u044B \u04B1\u0448\u0443\u0493\u0430 \u0431\u043E\u043B\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309654
    m_Localized: "\u0410\u043F\u0430\u0442 \u0436\u044B\u043B\u0434\u0430\u043C\u0434\u044B\u0493\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309655
    m_Localized: "\u043C/\u0441"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309656
    m_Localized: "\u0410\u0443\u0430 \u043A\u0435\u0434\u0435\u0440\u0433\u0456\u0441\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309657
    m_Localized: "\u041C\u043E\u0442\u043E\u0440 \u043A\u0435\u0448\u0456\u0433\u0443\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309658
    m_Localized: "\u0411\u0430\u0442\u0430\u0440\u0435\u044F \u043A\u0435\u0440\u043D\u0435\u0443\u0456\u043D\u0456\u04A3 \u0442\u04AF\u0441\u0443\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309659
    m_Localized: "\u041A\u0435\u0434\u0435\u0440\u0433\u0456 \u0430\u0437 = \u0436\u0435\u04A3\u0456\u043B \u04D9\u0440\u0456 \u0436\u044B\u043B\u0434\u0430\u043C. \u041C\u043E\u0442\u043E\u0440 \u043A\u0435\u0448\u0456\u0433\u0443\u0456 \u043A\u04E9\u043F = \u0433\u0430\u0437\u0493\u0430 \u0436\u04B1\u043C\u0441\u0430\u049B, \u0431\u0430\u044F\u0443 \u0436\u0430\u0443\u0430\u043F."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309660
    m_Localized: "\u0428\u0430\u049B\u044B\u0440\u0443 \u0431\u0435\u043B\u0433\u0456\u0441\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309661
    m_Localized: "\u0420\u0435\u043A\u043E\u0440\u0434\u0442\u0430\u0440 \u043A\u0435\u0441\u0442\u0435\u0441\u0456\u043D\u0434\u0435 \u0436\u04D9\u043D\u0435 \u043E\u043D\u043B\u0430\u0439\u043D\u0434\u0430\u0493\u044B \u0431\u0430\u0441\u049B\u0430 \u04B1\u0448\u049B\u044B\u0448\u0442\u0430\u0440\u0493\u0430 \u043A\u04E9\u0440\u0441\u0435\u0442\u0456\u043B\u0435\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309662
    m_Localized: "\u0410\u0439\u043D\u0430\u043B\u044B\u043C \u0443\u0430\u049B\u044B\u0442\u044B\u043D \u043E\u043D\u043B\u0430\u0439\u043D \u0436\u0430\u0440\u0438\u044F\u043B\u0430\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309663
    m_Localized: "\u049A\u043E\u0441\u0443\u043B\u044B: \u043A\u0456\u0440\u0456\u0441\u0442\u0456\u0440\u0456\u043B\u0433\u0435\u043D \u0442\u0440\u0430\u0441\u0441\u0430\u0434\u0430\u0493\u044B \u04D9\u0440 \u0430\u044F\u049B\u0442\u0430\u043B\u0493\u0430\u043D \u0436\u0430\u0440\u044B\u0441\u0442\u044B\u04A3 \u0435\u04A3 \u0436\u0430\u049B\u0441\u044B \u0430\u0439\u043D\u0430\u043B\u044B\u043C\u044B \u043E\u043D\u043B\u0430\u0439\u043D \u043A\u0435\u0441\u0442\u0435\u0433\u0435 \u0436\u0456\u0431\u0435\u0440\u0456\u043B\u0435\u0434\u0456 (\u0430\u043D\u043E\u043D\u0438\u043C\u0434\u0456 \u043A\u0456\u0440\u0443)."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309664
    m_Localized: "\u0410\u0448\u044B\u049B \u0430\u043B\u0430\u04A3"
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309665
    m_Localized: "\u049A\u0430\u043B\u049B\u044B\u0493\u0430\u043D \u049B\u0430\u049B\u043F\u0430\u0441\u044B \u043C\u0435\u043D \u043A\u0435\u0434\u0435\u0440\u0433\u0456\u0441\u0456 \u0431\u0430\u0440 \u04AF\u043B\u043A\u0435\u043D \u0430\u0448\u044B\u049B \u0448\u0435\u04A3\u0431\u0435\u0440. \u04AE\u0439\u0440\u0435\u043D\u0443\u0433\u0435 \u043A\u0435\u04A3 \u043E\u0440\u044B\u043D."
    m_Metadata:
      m_Items: []
  - m_Id: 2872970309666
