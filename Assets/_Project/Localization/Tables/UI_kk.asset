    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061791
    m_Localized: "4-\u0431\u04B1\u0440\u044B\u0448\u049B\u0430 \u04B1\u0448\u044B\u043F, 2 \u0441\u0435\u043A\u0443\u043D\u0434 \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061792
    m_Localized: "\u0428\u0430\u0440\u0448\u044B\u043D\u044B \u0436\u0430\u0431\u044B\u04A3\u044B\u0437: 1-\u0431\u04B1\u0440\u044B\u0448\u049B\u0430 \u049B\u0430\u0439\u0442\u044B\u043F, 2 \u0441\u0435\u043A\u0443\u043D\u0434 \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061793
    m_Localized: "\u0428\u0430\u0440\u0448\u044B, \u049B\u04B1\u0439\u0440\u044B\u0493\u044B \u04E9\u0437\u0456\u04A3\u0456\u0437\u0433\u0435 \u049B\u0430\u0440\u0430\u0439"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061794
    m_Localized: "\u0422\u04E9\u0440\u0442 \u049B\u043E\u0440\u0430\u043F \u0430\u0440\u049B\u044B\u043B\u044B \u0448\u0430\u0440\u0448\u044B \u0431\u043E\u0439\u044B\u043C\u0435\u043D \u04B1\u0448\u044B\u043F, \u04D9\u0440\u049B\u0430\u0439\u0441\u044B\u0441\u044B\u043D\u0434\u0430 \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437. \u0414\u0440\u043E\u043D \u04AF\u043D\u0435\u043C\u0456 \u0441\u0456\u0437\u0434\u0435\u043D \u0442\u0435\u0440\u0456\u0441 \u049B\u0430\u0440\u0430\u043F \u0442\u04B1\u0440\u0441\u044B\u043D, \u0441\u043E\u043D\u0434\u0430 \u0441\u043E\u043B \u0436\u0430\u049B \u04D9\u0440\u049B\u0430\u0448\u0430\u043D \u0441\u043E\u043B \u0436\u0430\u049B \u0431\u043E\u043B\u0430\u0434\u044B. \u0421\u043E\u0434\u0430\u043D \u043A\u0435\u0439\u0456\u043D \u049B\u0430\u0439\u0442\u044B\u043F, \u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061795
    m_Localized: "\u049A\u04B1\u0439\u0440\u044B\u049B\u0442\u044B \u04E9\u0437\u0456\u04A3\u0456\u0437\u0433\u0435 \u049B\u0430\u0440\u0430\u0442\u044B\u043F \u04B1\u0441\u0442\u0430\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6765196323061796
    m_Localized: "\u0421\u043E\u043B \u0441\u0442\u0438\u043A\u0442\u0456 \u043E\u04A3\u0493\u0430-\u0441\u043E\u043B\u0493\u0430 \u049B\u043E\u0437\u0493\u0430\u043C\u0430\u0439, \u043E\u0440\u0442\u0430\u0441\u044B\u043D\u0434\u0430 \u04B1\u0441\u0442\u0430\u04A3\u044B\u0437: \u0431\u04B1\u043B \u0436\u0430\u0442\u0442\u044B\u0493\u0443\u0434\u0430 \u0434\u0440\u043E\u043D \u0431\u04B1\u0440\u044B\u043B\u043C\u0430\u0439\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039097585664
    m_Localized: "\u041A\u0435\u0440\u0456 \u04B1\u0448\u044B\u043F, \u0430\u043B\u0430\u04A3\u0448\u0430\u0493\u0430 \u049B\u043E\u043D\u044B\u043F, \u049B\u043E\u0437\u0493\u0430\u043B\u0442\u049B\u044B\u0448\u0442\u0430\u0440\u0434\u044B \u04E9\u0448\u0456\u0440\u0456\u04A3\u0456\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694528
    m_Localized: "1-\u0431\u04B1\u0440\u044B\u0448\u049B\u0430 \u04B1\u0448\u044B\u043F, \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694529
    m_Localized: "\u0422\u04B1\u043C\u0441\u044B\u049B\u0442\u044B \u043A\u0435\u043B\u0435\u0441\u0456 \u0431\u04B1\u0440\u044B\u0448\u049B\u0430 \u0431\u04B1\u0440\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694530
    m_Localized: "2-\u0431\u04B1\u0440\u044B\u0448\u049B\u0430 \u04B1\u0448\u044B\u043F, \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694531
    m_Localized: "3-\u0431\u04B1\u0440\u044B\u0448\u049B\u0430 \u04B1\u0448\u044B\u043F, \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694532
    m_Localized: "4-\u0431\u04B1\u0440\u044B\u0448\u049B\u0430 \u04B1\u0448\u044B\u043F, \u0442\u043E\u049B\u0442\u0430\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694533
    m_Localized: "\u0428\u0430\u0440\u0448\u044B\u043D\u044B \u0436\u0430\u0431\u044B\u04A3\u044B\u0437: 1-\u0431\u04B1\u0440\u044B\u0448\u049B\u0430 \u049B\u0430\u0439\u0442\u0430 \u04B1\u0448\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694534
    m_Localized: "\u0428\u0430\u0440\u0448\u044B, \u0442\u04B1\u043C\u0441\u044B\u0493\u044B \u0430\u043B\u0493\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694535
    m_Localized: "\u0428\u0430\u0440\u0448\u044B\u043D\u044B \u049B\u0430\u0439\u0442\u0430 \u04B1\u0448\u044B\u04A3\u044B\u0437, \u0431\u0456\u0440\u0430\u049B \u0431\u04B1\u043B \u0436\u043E\u043B\u044B \u04D9\u0440 \u0431\u04B1\u0440\u044B\u0448\u0442\u0430 \u0434\u0440\u043E\u043D\u0434\u044B \u0431\u04B1\u0440\u044B\u043F, \u0442\u04B1\u043C\u0441\u044B\u0493\u044B \u04D9\u0440\u0434\u0430\u0439\u044B\u043C \u04B1\u0448\u0443 \u0431\u0430\u0493\u044B\u0442\u044B\u043D\u0430 \u049B\u0430\u0440\u0430\u043F \u0442\u04B1\u0440\u0441\u044B\u043D. \u041E\u043B \u0441\u0456\u0437\u0433\u0435 \u049B\u0430\u0440\u0430\u0439 \u04B1\u0448\u049B\u0430\u043D\u0434\u0430, \u043E\u04A3 \u043C\u0435\u043D \u0441\u043E\u043B \u0430\u0443\u044B\u0441\u0430\u0434\u044B."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694536
    m_Localized: "\u0421\u044B\u0437\u044B\u049B \u0431\u043E\u0439\u044B\u043D\u0434\u0430 \u049B\u0430\u043B\u0443"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694537
    m_Localized: "\u0414\u0440\u043E\u043D\u0493\u0430 \u0435\u043C\u0435\u0441, \u043A\u0435\u043B\u0435\u0441\u0456 \u049B\u043E\u0440\u0430\u043F\u049B\u0430 \u049B\u0430\u0440\u0430\u043F, \u0442\u0443\u0440\u0430 \u0441\u043E\u0493\u0430\u043D \u04B1\u0448\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694538
    m_Localized: "\u0411\u0430\u0493\u0430\u043D\u0430 \u0430\u043B\u0434\u044B\u043D\u0434\u0430\u0493\u044B \u049B\u043E\u0440\u0430\u043F\u049B\u0430 \u04B1\u0448\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694539
    m_Localized: "\u0422\u04B1\u043C\u0441\u044B\u049B\u0442\u044B \u0431\u0430\u0493\u0430\u043D\u0430\u0493\u0430 \u049B\u0430\u0440\u0430\u0442\u044B\u043F, \u0431\u0430\u0493\u0430\u043D\u0430\u043D\u044B \u0441\u0430\u0493\u0430\u0442 \u0442\u0456\u043B\u0456 \u0431\u0430\u0493\u044B\u0442\u044B\u043C\u0435\u043D \u0431\u0456\u0440 \u0430\u0439\u043D\u0430\u043B\u044B\u04A3\u044B\u0437"
    m_Metadata:
      m_Items: []
  - m_Id: 6771039164694540
    m_Localized: "\u0415\u043D\u0434\u0456 \u043A\u0435\u0440\u0456 \u0431\u0430\u0493\u044B\u0442\u0442\u0430 \u0431\u0456\u0440 \u0440\u0435\u0442, \u0442\u04B1\u043C\u0441\u044B\u049B \u04D9\u043B\u0456 \u0431\u0430\u0493\u0430\u043D\u0430\u0493\u0430 \u049B\u0430\u0440\u0430\u043F \u0442\u04B1\u0440\u0441\u044B\u043D"
