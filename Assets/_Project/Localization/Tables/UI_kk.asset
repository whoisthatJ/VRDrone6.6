  - m_Id: 708479750762500
    m_Localized: "\u041E\u04A3\u0430\u0439: \u0442\u0435\u043A \u049B\u043E\u0437\u0493\u0430\u043B\u043C\u0430\u0439\u0442\u044B\u043D \u043D\u044B\u0441\u0430\u043D\u0430\u043B\u0430\u0440. \u049A\u0430\u043B\u044B\u043F\u0442\u044B \u0434\u0435\u04A3\u0433\u0435\u0439\u0434\u0435 \u049B\u043E\u0437\u0493\u0430\u043B\u0430\u0442\u044B\u043D \u043A\u043E\u043B\u043E\u043D\u043D\u0430\u043B\u0430\u0440 \u043C\u0435\u043D \u0431\u0456\u0440\u043D\u0435\u0448\u0435 \u0436\u0430\u043B\u0442\u0430\u0440\u0443\u0448\u044B \u043A\u04E9\u043B\u0456\u043A \u049B\u043E\u0441\u044B\u043B\u0430\u0434\u044B; \u049A\u0438\u044B\u043D \u0434\u0435\u04A3\u0433\u0435\u0439\u0434\u0435 \u043E\u043B\u0430\u0440 \u043A\u04E9\u0431\u0456\u0440\u0435\u043A. 8 \u043C/\u0441 \u043D\u0435\u043C\u0435\u0441\u0435 \u0436\u044B\u043B\u0434\u0430\u043C\u044B\u0440\u0430\u049B \u0441\u043E\u0493\u044B\u04A3\u044B\u0437; \u0441\u0435\u0440\u0438\u044F \u04B1\u043F\u0430\u0439\u043B\u0430\u0440\u0434\u044B \u043A\u04E9\u0431\u0435\u0439\u0442\u0435\u0434\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 708479750762501
