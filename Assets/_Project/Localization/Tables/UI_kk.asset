  - m_Id: 708479750762503
    m_Localized: "1,2 \u043A\u043C \u0434\u0430\u043B\u0430 \u043F\u043E\u043B\u0438\u0433\u043E\u043D\u044B\u043D\u0434\u0430\u0493\u044B \u0435\u043A\u0456 \u043C\u0438\u043D\u0443\u0442\u0442\u044B\u049B \u0440\u0430\u0443\u043D\u0434\u0442\u0430\u0440: \u04AF\u0448 \u04B1\u0448\u044B\u0440\u0443 \u0430\u043B\u0430\u04A3\u044B\u043D\u0430\u043D \u049B\u043E\u0437\u0493\u0430\u043B\u043C\u0430\u0439\u0442\u044B\u043D, \u049B\u043E\u0437\u0493\u0430\u043B\u0430\u0442\u044B\u043D \u0436\u04D9\u043D\u0435 \u0436\u0430\u043B\u0442\u0430\u0440\u0443\u0448\u044B \u043A\u04E9\u043B\u0456\u043A\u0442\u0435\u0440\u0434\u0456 \u0436\u0430\u043B\u0493\u044B\u0437 \u043D\u0435\u043C\u0435\u0441\u0435 \u0431\u043E\u0442\u0442\u0430\u0440\u0493\u0430 \u049B\u0430\u0440\u0441\u044B \u0441\u043E\u0493\u044B\u04A3\u044B\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 708479750762504
    m_Localized: "\u0416\u043E\u043B\u0434\u0430\u0440\u044B, \u04AF\u0439\u0456\u043D\u0434\u0456\u043B\u0435\u0440\u0456 \u043C\u0435\u043D \u043A\u0430\u043F\u043E\u043D\u0438\u0440\u043B\u0435\u0440\u0456 \u0431\u0430\u0440 \u0434\u0430\u043B\u0430 \u043F\u043E\u043B\u0438\u0433\u043E\u043D\u044B: \u049B\u043E\u0437\u0493\u0430\u043B\u043C\u0430\u0439\u0442\u044B\u043D, \u049B\u043E\u0437\u0493\u0430\u043B\u0430\u0442\u044B\u043D \u0436\u04D9\u043D\u0435 \u0436\u0430\u043B\u0442\u0430\u0440\u0443\u0448\u044B \u043D\u044B\u0441\u0430\u043D\u0430\u043B\u0430\u0440\u0493\u0430 FPV \u0441\u043E\u049B\u049B\u044B \u0436\u0430\u0442\u0442\u044B\u0493\u0443\u044B."
