    m_Localized: "\u0434\u0440\u043E\u043D \u04B1\u0448\u049B\u044B\u0448\u044B\u043D \u0434\u0430\u044F\u0440\u043B\u0430\u0443 \u043A\u0443\u0440\u0441\u044B\u043D\u044B\u04A3"
    m_Metadata:
      m_Items: []
