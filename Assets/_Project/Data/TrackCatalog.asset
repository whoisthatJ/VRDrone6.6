%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: bf2426122a92b6a479c7c4056bec270e, type: 3}
  m_Name: TrackCatalog
  m_EditorClassIdentifier: GateRush.Game::GateRush.Game.TrackCatalog
  Tracks:
  - Id: field
    DisplayName: Open Field
    Description: Big outdoor loop with a floating gate and a hurdle. Room to learn.
    Json: {fileID: 4900000, guid: 2b962c0c5c2525843a77e4114911506d, type: 3}
  - Id: hangar
    DisplayName: Hangar 7
    Description: 'Indoor hall: tight turns between crates, columns and walls. Whoop heaven.'
    Json: {fileID: 4900000, guid: 2dd414e040841ea4790a3db43389531c, type: 3}
  - Id: industrial
    DisplayName: Dockyard
    Description: Container corridors and a gate above a container stack.
    Json: {fileID: 4900000, guid: ee31c46cd8b798a40b850617b17648aa, type: 3}
  - Id: spline-test
    DisplayName: Spline Test Loop
    Description: Figure-eight lane track with an overpass (spline track system test).
    Json: {fileID: 4900000, guid: 9c367b8fd3d888d41ba92c0abd0a3c02, type: 3}
  - Id: stadium-oval
    DisplayName: Stadium Oval
    Description: 'Floodlit football stadium: an easy oval around the pitch. Learn the lanes and gates.'
    Json: {fileID: 4900000, guid: 481cab861150c8a458796624b8d6e691, type: 3}
  - Id: serpent-arena
    DisplayName: Serpent Arena
    Description: 'The stadium race track: loops round the landing pads, a figure-eight at the centre spot and four overpasses.'
    Json: {fileID: 4900000, guid: ce521c4b474270e46a5b63650c7880bf, type: 3}
  - Id: expo-v2-sprint
    DisplayName: Expo Sprint
    Description: 'Beginner, 1.2 km: up the south walkway, over a pavilion into its courtyard, round the sphere at 3 m, a park slalom and back down the walkway. Trainer guidance recommended.'
    Json: {fileID: 4900000, guid: 920dde672eb45d04a8d5f4dd14ef57c4, type: 3}
  - Id: expo-v2-pro
    DisplayName: Expo Pro
    Description: 'Advanced, 2.2 km: the courtyard hop, a helix round the sphere to 90 m, the dive into the park, the ring-road sweeper and a second courtyard.'
    Json: {fileID: 4900000, guid: ad8e9fd3e09cb5249995716d7866676b, type: 3}
  - Id: expo-v2-free
    DisplayName: Expo Free Flight
    Description: 'No gates: fly anywhere within 1.2 km of the sphere and up to 150 m. F / D-pad up switches between the south plaza, above the sphere, the park and the ring road; T resets.'
    Json: {fileID: 4900000, guid: c52a1f8a5e1761d4581cda615da13d67, type: 3}
  - Id: expo-astana
    DisplayName: Expo Classic Sprint
    Description: 'The original Expo Sprint (Track_Expo_v1): the courtyard hop, the low sphere orbit and the park slalom, in the first look of the district.'
    Json: {fileID: 4900000, guid: addb4e50095f6bb438e51f185e08324a, type: 3}
  - Id: expo-pro
    DisplayName: Expo Classic Pro
    Description: 'The original Expo Pro (Track_Expo_v1): helix to 90 m, the park dive, the ring-road sweeper and the second courtyard.'
    Json: {fileID: 4900000, guid: 6948040d84bb9c747b437a728c118a82, type: 3}
  - Id: expo-free
    DisplayName: Expo Classic Free Flight
    Description: Free flight in the original district (Track_Expo_v1).
    Json: {fileID: 4900000, guid: ee843bf88a3b87e488b9470c7a4a9bcf, type: 3}
  Environments:
  - Environment: field
    SceneName: Track_Field
  - Environment: hangar
    SceneName: Track_Hangar
  - Environment: industrial
    SceneName: Track_Industrial
  - Environment: stadium
    SceneName: Track_Stadium
  - Environment: expo
    SceneName: Track_Expo
  - Environment: expo_v1
    SceneName: Track_Expo_v1
